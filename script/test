#!/usr/bin/env sh
set -eu

npm test
python3 -m json.tool botster-package.json >/dev/null
python3 -m json.tool fixtures/project_pipelines/domain_contract.json >/dev/null

python3 - <<'PY'
import json
import re
from pathlib import Path

manifest = json.loads(Path("botster-package.json").read_text())
fixture = json.loads(Path("fixtures/project_pipelines/domain_contract.json").read_text())
source = Path("plugin.lua").read_text()
assert manifest["name"] == "project-pipelines"
assert manifest["version"] == "0.2.0"
assert manifest["entrypoints"] == [{"runtime": "lua", "path": "plugin.lua", "bootstrap": False}]
assert {capability["surface"] for capability in manifest["capabilities"]} == {
    "surfaces", "mcp", "plugin_db", "session_actions"
}
assert "require(" not in source
assert "plugin_db.batch" in source
assert 'STORE_ROOT = "v3/"' in source
assert fixture["contract_version"] == 3
assert fixture["persistence_boundaries"]["runtime_storage_namespace"] == "v3/<family>/<id>"
for family in ["project_target", "ticket_dependency", "run_step"]:
    assert family in fixture["domain_objects"]
surface_ids = {surface["id"] for surface in manifest["surfaces"]}
assert {"project-pipelines.home", "project-pipelines.settings"} <= surface_ids
navigation_targets = {item["target"]["surface_id"] for item in manifest["navigation"]}
assert "project-pipelines.home" in navigation_targets
readme = Path("README.md").read_text()
domain_contract = Path("docs/domain-contract.md").read_text()
for phrase in ["Public MCP Contract", "Drain-first Cold Cut", "plugin_db.batch", "entity_provider"]:
    assert phrase in readme
for phrase in ["Persistence Boundaries", "entity_provider", "provider-specific merge execution"]:
    assert phrase in domain_contract
for dead_name in ["empty_schema", "repository_from", "show_project", "show_ticket", "update_ticket_status", "list_pipeline_definitions", "record_run", "run_status_tone"]:
    assert f"local function {dead_name}" not in source

scan_paths = [
    ".gitignore", "README.md", "botster-package.json", "plugin.lua",
    "script/test", "script/cutover", "script/test-cutover", "script/test-hub-flow",
    "script/hub_acceptance_smoke", "docs/domain-contract.md",
    "fixtures/project_pipelines/domain_contract.json",
]
pii_pattern = re.compile(
    r"/" + r"Users/|/" + r"home/|jason" + r"conigliari|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}",
    re.I,
)
for known_positive in [
    "/" + "Users/example/known-positive",
    "/" + "home/example/known-positive",
    "jason" + "conigliari",
    "agent" + "@" + "example" + "." + "invalid",
]:
    assert pii_pattern.search(known_positive), f"PII guard arm did not match {known_positive}"
for path in scan_paths:
    match = pii_pattern.search(Path(path).read_text())
    assert not match, f"PII or operator path in {path}: {match.group(0)}"
PY

lua_test="$(mktemp "${TMPDIR:-/tmp}/botster-project-pipelines-test.XXXXXX")"
trap 'rm -f "$lua_test"' EXIT HUP INT TERM

cat > "$lua_test" <<'LUA'
local durable_store = {}
local fail_batch_key_prefix = nil

local function copy(value)
  if type(value) ~= "table" then return value end
  local result = {}
  for key, nested in pairs(value) do result[key] = copy(nested) end
  return result
end

local function list(args)
  local entries = {}
  for key, record in pairs(durable_store) do
    if not args.prefix or key:sub(1, #args.prefix) == args.prefix then
      table.insert(entries, { key = key, schema_version = record.schema_version, revision = record.revision })
    end
  end
  table.sort(entries, function(left, right) return left.key < right.key end)
  return { entries = entries }
end

local function batch(args)
  local candidate = copy(durable_store)
  local results = {}
  local seen = {}
  for index, mutation in ipairs(args.mutations or {}) do
    local key = mutation.key
    if fail_batch_key_prefix and key and key:sub(1, #fail_batch_key_prefix) == fail_batch_key_prefix then
      return { ok = false, error_kind = "backend_failed", message = "injected batch failure", mutation_index = index, key = key }
    end
    if not key or seen[key] then
      return { ok = false, error_kind = "invalid_request", message = "invalid or duplicate key", mutation_index = index, key = key }
    end
    seen[key] = true
    local previous = candidate[key]
    local actual_revision = previous and previous.revision or 0
    if mutation.expected_revision ~= actual_revision then
      return { ok = false, error_kind = "revision_conflict", message = "revision conflict", mutation_index = index, key = key }
    end
    if mutation.operation == "delete" then
      if not previous then
        return { ok = false, error_kind = "store_not_found", message = "record missing", mutation_index = index, key = key }
      end
      candidate[key] = nil
      table.insert(results, { operation = "delete", key = key, revision = actual_revision + 1 })
    elseif mutation.operation == "set" then
      local record = {
        key = key, schema_version = mutation.schema_version or 1,
        revision = actual_revision + 1, payload = copy(mutation.payload),
      }
      candidate[key] = record
      table.insert(results, { operation = "set", record = copy(record) })
    else
      return { ok = false, error_kind = "invalid_request", message = "unsupported operation", mutation_index = index, key = key }
    end
  end
  durable_store = candidate
  return { ok = true, results = results }
end

local spawned = {}
botster = {
  capabilities = {
    plugin_db = {
      get = function(args)
        local record = durable_store[args.key]
        return record and { record = copy(record) } or {}
      end,
      list = list,
      batch = batch,
    },
    config = { get = function() return { values = {} } end },
    session_templates = {
      list = function()
        return { templates = { { id = "template_codex", name = "Codex", capabilities = { "codex" } } } }
      end,
      spawn = function(args)
        table.insert(spawned, copy(args))
        return { ok = true, result = { request_id = args.request_id, session_uuid = "session-" .. tostring(#spawned) } }
      end,
      ensure_worktree_and_spawn = function(args)
        table.insert(spawned, copy(args))
        return { session_id = "session-" .. tostring(#spawned), worktree_id = "worktree-" .. tostring(#spawned) }
      end,
    },
  },
  register = function(spec) return spec end,
}

local plugin = dofile("plugin.lua")
local tools = {}
local descriptors = {}
for _, descriptor in ipairs(plugin.tools) do
  assert(not tools[descriptor.name], "duplicate tool " .. descriptor.name)
  tools[descriptor.name] = descriptor.call
  descriptors[descriptor.name] = descriptor
  assert(type(descriptor.description) == "string" and #descriptor.description > 20, "tool description must be authored")
  local generated = descriptor.name:gsub("^project_pipelines%.", ""):gsub("_", " ") .. "."
  assert(descriptor.description ~= generated, "generated tool description remains " .. descriptor.name)
  assert(type(descriptor.input_schema) == "table" and descriptor.input_schema.type == "object")
  assert(type(descriptor.input_schema.properties) == "table" and next(descriptor.input_schema.properties), "tool properties must be discoverable")
  if descriptor.input_schema.required ~= nil then
    assert(type(descriptor.input_schema.required) == "table" and #descriptor.input_schema.required > 0, "required must be a nonempty array")
  end
end

local source_file = assert(io.open("plugin.lua", "r"))
local plugin_source = source_file:read("*a")
source_file:close()
local handler_source = assert(plugin_source:match("^(.-)\nlocal TOOL_CONTRACTS ="))
local unhandled_contract_properties = {}
for _, descriptor in ipairs(plugin.tools) do
  for property in pairs(descriptor.input_schema.properties) do
    local dot_reference = "arguments." .. property
    local quoted_reference = '"' .. property .. '"'
    if not handler_source:find(dot_reference, 1, true) and not handler_source:find(quoted_reference, 1, true) then
      table.insert(unhandled_contract_properties, descriptor.name .. ":" .. property)
    end
  end
end
assert(#unhandled_contract_properties == 0, "advertised properties without handler references: " .. table.concat(unhandled_contract_properties, ", "))

local required = {
  "add_artifact", "add_checklist_item", "add_project_target", "add_ticket_dependency",
  "answer_question", "ask_agent", "ask_human", "cancel_run",
  "checklist_instructions", "claim_question_orchestrator", "close_ticket",
  "create_checklist", "create_child_run", "create_gate", "create_pipeline",
  "create_project", "create_step", "create_ticket", "create_vault_checklist",
  "current_context", "delete_gate", "delete_pipeline", "delete_project",
  "delete_step", "delete_ticket", "escalate_question", "get_checklist",
  "get_pipeline", "get_pr_link", "get_project", "get_ticket", "link_pr",
  "list_agent_choices", "list_checklists", "list_pipelines", "list_pr_links",
  "list_projects", "list_ticket_dependencies", "list_tickets",
  "question_orchestrator_status", "receive_question_answers",
  "release_question_orchestrator", "remove_project_target",
  "remove_ticket_dependency", "request_merge", "request_step_advance",
  "resolve_finding", "retry_step_agent", "search_tickets",
  "spawn_ticket_session", "start_run", "submit_gate", "submit_review",
  "update_checklist", "update_checklist_item", "update_gate",
  "update_pipeline", "update_project", "update_step", "update_step_agent",
  "update_ticket",
}
for _, name in ipairs(required) do
  assert(tools["project_pipelines." .. name], "missing required tool " .. name)
end
local retired = {
  "activate_step", "define_pipeline", "list_pipeline_definitions",
  "show_pipeline_definition", "record_run", "record_artifact",
  "record_question", "update_ticket_status", "show_project", "show_ticket",
}
for _, name in ipairs(retired) do
  assert(not tools["project_pipelines." .. name], "retired tool remains " .. name)
end
assert(tools["project_pipelines.resolve_repository_playbook"])
assert(tools["project_pipelines.entities"])
assert(#plugin.tools == #required + 2, "descriptor set must be closed")
assert(descriptors["project_pipelines.submit_review"].input_schema.properties.verdict.enum[2] == "changes_required")
assert(descriptors["project_pipelines.submit_review"].input_schema.properties.findings.items.properties.severity.enum[1] == "blocker")
assert(descriptors["project_pipelines.update_ticket"].input_schema.properties.status.enum[4] == "closed")
assert(descriptors["project_pipelines.create_checklist"].input_schema.properties.scope.enum[3] == "run")
assert(descriptors["project_pipelines.create_checklist"].input_schema.properties.run_id.type == "string")
assert(descriptors["project_pipelines.list_checklists"].input_schema.properties.run_id.type == "string")
assert(descriptors["project_pipelines.retry_step_agent"].input_schema.required[1] == "run_id")
assert(descriptors["project_pipelines.remove_project_target"].input_schema.properties.project_target_id.type == "string")

for _, name in ipairs({
  "add_project_target", "remove_project_target", "update_project", "delete_project",
  "update_ticket", "get_ticket", "get_project", "delete_ticket", "update_pipeline",
  "delete_pipeline", "create_step", "update_step", "delete_step", "create_gate",
  "update_gate", "delete_gate", "start_run", "create_child_run", "close_ticket",
  "spawn_ticket_session", "get_checklist", "update_checklist", "update_checklist_item",
  "create_vault_checklist", "get_pr_link", "escalate_question",
}) do
  assert(pcall(tools["project_pipelines." .. name], nil), name .. " must reject nil arguments without crashing")
end

local resolve_playbook = tools["project_pipelines.resolve_repository_playbook"]
local expected_routes = {
  ["botster-core"] = "[[botster-core-playbook]]",
  ["botster-hub"] = "[[botster-hub-playbook]]",
  ["botster-hub-client"] = "[[botster-hub-client-playbook]]",
  ["botster-web"] = "[[botster-web-playbook]]",
  ["botster-workspaces"] = "[[botster-workspaces-playbook]]",
  ["botster-tui"] = "[[botster-tui-playbook]]",
  ["botster-tui-kit"] = "[[botster-tui-kit-playbook]]",
  ["botster-terminal-ghostty"] = "[[botster-terminal-ghostty-playbook]]",
  ["botster-project-pipelines"] = "[[project-pipelines-playbook]]",
}
for repository, playbook in pairs(expected_routes) do
  assert(resolve_playbook({ repository = "trybotster/" .. repository }).playbook == playbook)
end
assert(not resolve_playbook({ repository = "trybotster/restty" }).ok, "unsupported repository must require a routing question")
assert(not resolve_playbook({ repository = "botster-core", path = "plugin.lua" }).ok, "ambiguous routing must require a question")

