assert(tools["project_pipelines.update_checklist_item"]({ item_id = "item-one", status = "done", evidence = { command = "script/test" } }).ok)
assert(tools["project_pipelines.add_artifact"]({ run_id = "run-atomic", kind = "report", summary = "Atomic proof" }).ok)
