#!/usr/bin/env sh
set -eu

npm test
python3 -m json.tool botster-package.json >/dev/null
python3 -m json.tool fixtures/project_pipelines/domain_contract.json >/dev/null

python3 - <<'PY'
import json
from pathlib import Path

manifest = json.loads(Path("botster-package.json").read_text())
source = Path("plugin.lua").read_text()
assert manifest["name"] == "project-pipelines"
assert manifest["entrypoints"] == [{"runtime": "lua", "path": "plugin.lua", "bootstrap": False}]
assert {capability["surface"] for capability in manifest["capabilities"]} == {
    "surfaces", "mcp", "plugin_db", "session_actions"
}
assert "require(" not in source
assert "plugin_db.batch" in source
assert 'STORE_ROOT = "v3/"' in source
PY

lua_test="$(mktemp "${TMPDIR:-/tmp}/botster-project-pipelines-test.XXXXXX")"
trap 'rm -f "$lua_test"' EXIT HUP INT TERM

cat > "$lua_test" <<'LUA'
local durable_store = {}
local fail_batch_key_prefix = nil

local function copy(value)
  if type(value) ~= "table" then return value end
  local result = {}
  for key, nested in pairs(value) do result[key] = copy(nested) end
  return result
end

local function list(args)
  local entries = {}
  for key, record in pairs(durable_store) do
    if not args.prefix or key:sub(1, #args.prefix) == args.prefix then
      table.insert(entries, { key = key, schema_version = record.schema_version, revision = record.revision })
    end
  end
  table.sort(entries, function(left, right) return left.key < right.key end)
  return { entries = entries }
end

local function batch(args)
  local candidate = copy(durable_store)
  local results = {}
  local seen = {}
  for index, mutation in ipairs(args.mutations or {}) do
    local key = mutation.key
    if fail_batch_key_prefix and key and key:sub(1, #fail_batch_key_prefix) == fail_batch_key_prefix then
      return { ok = false, error_kind = "backend_failed", message = "injected batch failure", mutation_index = index, key = key }
    end
    if not key or seen[key] then
      return { ok = false, error_kind = "invalid_request", message = "invalid or duplicate key", mutation_index = index, key = key }
    end
    seen[key] = true
    local previous = candidate[key]
    local actual_revision = previous and previous.revision or 0
    if mutation.expected_revision ~= actual_revision then
      return { ok = false, error_kind = "revision_conflict", message = "revision conflict", mutation_index = index, key = key }
    end
    if mutation.operation == "delete" then
      if not previous then
        return { ok = false, error_kind = "store_not_found", message = "record missing", mutation_index = index, key = key }
      end
      candidate[key] = nil
      table.insert(results, { operation = "delete", key = key, revision = actual_revision + 1 })
    elseif mutation.operation == "set" then
      local record = {
        key = key, schema_version = mutation.schema_version or 1,
        revision = actual_revision + 1, payload = copy(mutation.payload),
      }
      candidate[key] = record
      table.insert(results, { operation = "set", record = copy(record) })
    else
      return { ok = false, error_kind = "invalid_request", message = "unsupported operation", mutation_index = index, key = key }
    end
  end
  durable_store = candidate
  return { ok = true, results = results }
end

local spawned = {}
botster = {
  capabilities = {
    plugin_db = {
      get = function(args)
        local record = durable_store[args.key]
        return record and { record = copy(record) } or {}
      end,
      list = list,
      batch = batch,
    },
    config = { get = function() return { values = {} } end },
    session_templates = {
      list = function()
        return { templates = { { id = "template_codex", name = "Codex", capabilities = { "codex" } } } }
      end,
      spawn = function(args)
        table.insert(spawned, copy(args))
        return { ok = true, result = { request_id = args.request_id, session_uuid = "session-" .. tostring(#spawned) } }
      end,
    },
  },
  register = function(spec) return spec end,
}

local plugin = dofile("plugin.lua")
local tools = {}
for _, descriptor in ipairs(plugin.tools) do
  assert(not tools[descriptor.name], "duplicate tool " .. descriptor.name)
  tools[descriptor.name] = descriptor.call
end

local required = {
  "add_artifact", "add_checklist_item", "add_project_target", "add_ticket_dependency",
  "answer_question", "ask_agent", "ask_human", "cancel_run",
  "checklist_instructions", "claim_question_orchestrator", "close_ticket",
  "create_checklist", "create_child_run", "create_gate", "create_pipeline",
  "create_project", "create_step", "create_ticket", "create_vault_checklist",
  "current_context", "delete_gate", "delete_pipeline", "delete_project",
  "delete_step", "delete_ticket", "escalate_question", "get_checklist",
  "get_pipeline", "get_pr_link", "get_project", "get_ticket", "link_pr",
  "list_agent_choices", "list_checklists", "list_pipelines", "list_pr_links",
  "list_projects", "list_ticket_dependencies", "list_tickets",
  "question_orchestrator_status", "receive_question_answers",
  "release_question_orchestrator", "remove_project_target",
  "remove_ticket_dependency", "request_merge", "request_step_advance",
  "resolve_finding", "retry_step_agent", "search_tickets",
  "spawn_ticket_session", "start_run", "submit_gate", "submit_review",
  "update_checklist", "update_checklist_item", "update_gate",
  "update_pipeline", "update_project", "update_step", "update_step_agent",
  "update_ticket",
}
for _, name in ipairs(required) do
  assert(tools["project_pipelines." .. name], "missing required tool " .. name)
end
local retired = {
  "activate_step", "define_pipeline", "list_pipeline_definitions",
  "show_pipeline_definition", "record_run", "record_artifact",
  "record_question", "update_ticket_status", "show_project", "show_ticket",
}
for _, name in ipairs(retired) do
  assert(not tools["project_pipelines." .. name], "retired tool remains " .. name)
end
assert(tools["project_pipelines.resolve_repository_playbook"])
assert(tools["project_pipelines.entities"])
assert(#plugin.tools == #required + 2, "descriptor set must be closed")

local project = tools["project_pipelines.create_project"]({
  id = "project-one", name = "Project One", target_id = "target-one",
})
assert(project.ok)
assert(tools["project_pipelines.add_project_target"]({
  project_id = "project-one", target_id = "target-one",
}).ok)
assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-two-step", name = "Two Step",
  steps = {
    { id = "step-one", name = "One", next_step_id = "step-two" },
    { id = "step-two", name = "Two" },
  },
}).ok)

assert(tools["project_pipelines.create_ticket"]({
  id = "dependency-open", project_id = "project-one", title = "Dependency",
}).ok)
assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-blocked", project_id = "project-one", target_id = "target-one", title = "Blocked",
}).ok)
assert(tools["project_pipelines.add_ticket_dependency"]({
  ticket_id = "ticket-blocked", depends_on_ticket_id = "dependency-open",
}).ok)
local blocked = tools["project_pipelines.start_run"]({
  id = "run-blocked", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(not blocked.ok and blocked.error.code == "ticket_dependencies_unmet")
assert(tools["project_pipelines.update_ticket"]({ ticket_id = "dependency-open", status = "closed" }).ok)

fail_batch_key_prefix = "v3/run_steps/"
local failed = tools["project_pipelines.start_run"]({
  id = "run-atomic", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(not failed.ok and failed.error.code == "persist_failed")
local after_failure = tools["project_pipelines.current_context"]({})
local failed_ticket
for _, ticket in ipairs(after_failure.tickets) do if ticket.id == "ticket-blocked" then failed_ticket = ticket end end
assert(failed_ticket.status == "open", "failed atomic start must not activate ticket")
for _, run in ipairs(after_failure.runs) do assert(run.id ~= "run-atomic", "failed atomic start must not create run") end

fail_batch_key_prefix = nil
local started = tools["project_pipelines.start_run"]({
  id = "run-atomic", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(started.ok and started.ticket.status == "active")
assert(started.run.current_run_step_id == started.run_step.id)
assert(#tools["project_pipelines.get_ticket"]({ ticket_id = "ticket-blocked" }).runs == 1)
local checklist = tools["project_pipelines.create_checklist"]({
  id = "checklist-one", run_id = "run-atomic", owner_id = "run-atomic", name = "Proof",
  items = { { id = "item-one", prompt = "Verify atomic start" } },
})
assert(checklist.ok)
assert(#tools["project_pipelines.get_checklist"]({ checklist_id = "checklist-one" }).items == 1)
assert(tools["project_pipelines.update_checklist_item"]({ item_id = "item-one", status = "done", evidence = { command = "script/test" } }).ok)
assert(tools["project_pipelines.add_artifact"]({ run_id = "run-atomic", kind = "report", summary = "Atomic proof" }).ok)
local question = tools["project_pipelines.ask_human"]({ run_id = "run-atomic", ticket_id = "ticket-blocked", question = "Continue?" })
assert(question.ok)
assert(tools["project_pipelines.answer_question"]({ question_id = question.question.id, answer = "Yes" }).ok)
assert(#tools["project_pipelines.receive_question_answers"]({ all = true }).answers == 1)
local review = tools["project_pipelines.submit_review"]({
  run_id = "run-atomic", step_id = "step-one", verdict = "approved",
  findings = { { id = "finding-one", title = "Carry forward", severity = "medium" } },
})
assert(review.ok)
assert(tools["project_pipelines.resolve_finding"]({ finding_id = "finding-one", resolution = "Verified" }).ok)
local advanced = tools["project_pipelines.request_step_advance"]({
  run_id = "run-atomic", request_id = "advance-once",
})
assert(advanced.ok and advanced.step_id == "step-two")
local advanced_context = tools["project_pipelines.current_context"]({ run_id = "run-atomic" })
assert(#advanced_context.run_steps == 2)
assert(advanced_context.runs[1].current_step_id == "step-two")
assert(tools["project_pipelines.cancel_run"]({ run_id = "run-atomic" }).ticket.status == "open")

local restarted = tools["project_pipelines.start_run"]({
  id = "run-close", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(restarted.ok)
local closed = tools["project_pipelines.close_ticket"]({ ticket_id = "ticket-blocked" })
assert(closed.ok and closed.ticket.status == "closed")
local closed_context = tools["project_pipelines.current_context"]({ run_id = "run-close" })
assert(closed_context.runs[1].status == "closed")

assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-merge", project_id = "project-one", title = "Merge",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-merge", ticket_id = "ticket-merge", pipeline_id = "pipeline-two-step",
}).ok)
fail_batch_key_prefix = "v3/run_steps/"
assert(not tools["project_pipelines.request_merge"]({ run_id = "run-merge" }).ok)
local merge_failure = tools["project_pipelines.current_context"]({ run_id = "run-merge" })
assert(merge_failure.runs[1].status == "active")
fail_batch_key_prefix = nil
assert(tools["project_pipelines.link_pr"]({
  run_id = "run-merge", pr_url = "https://example.invalid/pr/1", repo = "example/repo", pr_number = 1,
}).ok)
assert(tools["project_pipelines.request_merge"]({ run_id = "run-merge" }).ok)

local entities = tools["project_pipelines.entities"]({})
assert(entities.ok and #entities.frames >= 5)
local handlers = {}
local entity_providers = {}
for _, handler in ipairs(plugin.handlers) do
  handlers[handler.descriptor_id] = handler.call
  if handler.kind == "entity_provider" then
    assert(handler.descriptor.entity_type == handler.descriptor_id)
    assert(handler.descriptor.id_field == "id")
    entity_providers[handler.descriptor_id] = handler.call
  end
end
local expected_entity_families = {
  "project", "project_target", "ticket", "ticket_dependency",
  "pipeline_definition", "run", "run_step", "gate_result", "review",
  "finding", "artifact", "checklist", "checklist_item", "question",
  "answer", "question_orchestrator", "pr_link", "event", "session_request",
}
local provider_count = 0
for _ in pairs(entity_providers) do provider_count = provider_count + 1 end
assert(provider_count == #expected_entity_families, "entity provider set must be closed")
for _, family in ipairs(expected_entity_families) do
  local entity_type = "project-pipelines." .. family
  local provider = entity_providers[entity_type]
  assert(provider, "missing entity provider " .. entity_type)
  local first_snapshot = provider({ entity_type = entity_type })
  local reconnect_snapshot = provider({ entity_type = entity_type })
  assert(first_snapshot.type == "entity_snapshot" and first_snapshot.entity_type == entity_type)
  assert(reconnect_snapshot.snapshot_seq == first_snapshot.snapshot_seq + 1, "reconnect snapshot must be fresh")
end
local run_snapshot = entity_providers["project-pipelines.run"]({ entity_type = "project-pipelines.run" })
assert(#run_snapshot.items == #tools["project_pipelines.current_context"]({}).runs, "run snapshot must match committed context")
local merged = handlers["pr_merged"]({ repo = "example/repo", pr_number = 1, merge_commit = "abc123" })
assert(merged.ok and merged.ticket.status == "closed" and merged.run.status == "closed")
local home = handlers["project-pipelines.home"]({})
assert(home.id == "project-pipelines-home")

local source_key = "v3/pipeline_definitions/botster_stack_delivery"
assert(durable_store[source_key], "sourced delivery definition missing")
durable_store[source_key].payload.steps[1].agent_name = "operator-selected"
durable_store[source_key].payload.source_revision = "stale"
local reloaded = dofile("plugin.lua")
local reloaded_tools = {}
for _, descriptor in ipairs(reloaded.tools) do reloaded_tools[descriptor.name] = descriptor.call end
local sourced
for _, pipeline in ipairs(reloaded_tools["project_pipelines.list_pipelines"]({}).pipelines) do
  if pipeline.id == "botster_stack_delivery" then sourced = pipeline end
end
assert(sourced and sourced.steps[1].agent_name == "operator-selected")
local routed = false
for _, step in ipairs(sourced.steps) do
  if step.prompt and step.prompt:find("botster%-workspaces%-playbook") then routed = true end
end
assert(routed, "Botster Stack Delivery must retain botster-workspaces routing")

print("project-pipelines authoritative package checks passed")
LUA

lua "$lua_test"
script/test-cutover
