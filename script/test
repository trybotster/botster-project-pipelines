local function context_for(run_id)
  return tools["project_pipelines.current_context"]({ run_id = run_id })
end

local function count_events(run_id, kind)
  local total = 0
  for _, event in ipairs(context_for(run_id).events) do
    if event.kind == kind then total = total + 1 end
  end
  return total
end

local function create_waiting_scenario(prefix, blocker_count)
  assert(tools["project_pipelines.create_ticket"]({
    id = prefix .. "-ticket", project_id = "project-one", target_id = "target-one", title = prefix .. " ticket",
  }).ok)
  local started_waiting = tools["project_pipelines.start_run"]({
    id = prefix .. "-run", ticket_id = prefix .. "-ticket", pipeline_id = "pipeline-waiting-wakeup",
  })
  assert(started_waiting.ok)
  local dependency_ids = {}
  for index = 1, blocker_count do
    local dependency_id = prefix .. "-dependency-" .. tostring(index)
    table.insert(dependency_ids, dependency_id)
    assert(tools["project_pipelines.create_ticket"]({
      id = dependency_id, project_id = "project-one", title = dependency_id,
    }).ok)
    assert(tools["project_pipelines.add_ticket_dependency"]({
      id = prefix .. "-row-" .. tostring(index),
      ticket_id = prefix .. "-ticket", dependency_ticket_id = dependency_id,
    }).ok)
  end
  assert(tools["project_pipelines.submit_review"]({
    run_id = prefix .. "-run", run_step_id = started_waiting.run_step.id,
    step_id = "waiting-plan-review", verdict = "approved",
  }).ok)
  local spawned_before = #spawned
  local waiting = tools["project_pipelines.request_step_advance"]({
    run_id = prefix .. "-run", request_id = prefix .. "-advance",
  })
  assert(not waiting.ok and waiting.error.code == "ticket_dependencies_unmet")
  local waiting_context = context_for(prefix .. "-run")
  assert(waiting_context.run.current_step_id == "waiting-plan-review")
  assert(waiting_context.run.current_run_step_id == started_waiting.run_step.id)
  assert(waiting_context.run.waiting_transition.source_run_step_id == started_waiting.run_step.id)
  assert(#waiting_context.run.waiting_transition.unmet_dependencies == blocker_count)
  assert(#waiting_context.run_steps == 1 and #spawned == spawned_before)
  return {
    run_id = prefix .. "-run",
    ticket_id = prefix .. "-ticket",
    run_step_id = started_waiting.run_step.id,
    dependency_ids = dependency_ids,
    spawned_before = spawned_before,
  }
end

local function assert_woken_once(scenario)
  local context = context_for(scenario.run_id)
  assert(context.run.current_step_id == "waiting-implement")
  assert(context.run.waiting_transition == nil)
  assert(#context.run_steps == 2, "final clearance must create exactly one target run-step")
  local source_visits, target_visits = 0, 0
  for _, run_step in ipairs(context.run_steps) do
    if run_step.id == scenario.run_step_id then
      source_visits = source_visits + 1
      assert(run_step.status == "done")
    elseif run_step.step_id == "waiting-implement" then
      target_visits = target_visits + 1
      assert(run_step.status == "active")
    end
  end
  assert(source_visits == 1 and target_visits == 1)
end

