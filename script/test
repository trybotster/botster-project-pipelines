}).ok)
assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-command", project_id = "project-one", target_id = "target-one", title = "Command",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-command", ticket_id = "ticket-command", pipeline_id = "pipeline-command",
}).ok)
local command_activation = tools["project_pipelines.spawn_ticket_session"]({ run_id = "run-command" })
assert(command_activation.ok and command_activation.activation.status == "preserved_non_pty", "command steps must remain non-spawning")
assert(#spawned == 4, "non-PTY activation must not dispatch")

-- The cut deleted the selector fields the pre-cut predicate also required, so step mode is
-- now the only admission input. Pin the whole admitted set rather than one example; `pty` and
-- `command` are already proven above.
do
  local cases = {
    { kind = "session", admitted = true },
    { kind = "session_type", admitted = true },
    { kind = "agent", admitted = false },
    { kind = "review", admitted = false },
    { kind = nil, admitted = false },
  }
  for _, case in ipairs(cases) do
    local suffix = "kind-" .. tostring(case.kind or "unset")
    assert(tools["project_pipelines.create_pipeline"]({
      id = "pipeline-" .. suffix, name = "Kind " .. suffix,
      steps = { { id = suffix .. "-step", name = "Kind step", kind = case.kind, session_type_id = "kind-session-type" } },
    }).ok)
    assert(tools["project_pipelines.create_ticket"]({
      id = "ticket-" .. suffix, project_id = "project-one", target_id = "target-one", title = "Kind " .. suffix,
    }).ok)
    assert(tools["project_pipelines.start_run"]({
      id = "run-" .. suffix, ticket_id = "ticket-" .. suffix, pipeline_id = "pipeline-" .. suffix,
    }).ok)
    local dispatched_before = #spawned
    local activation = tools["project_pipelines.spawn_ticket_session"]({ run_id = "run-" .. suffix })
    assert(activation.ok, "activation of " .. suffix .. " failed")
    if case.admitted then
      assert(activation.activation.status == "spawn_requested", suffix .. " must reach the session-type spawn path")
      assert(#spawned == dispatched_before + 1 and spawned[#spawned].session_type_id == "kind-session-type",
        suffix .. " must dispatch exactly one managed spawn")
    else
      assert(activation.activation.status == "preserved_non_pty",
        suffix .. " must preserve pre-cut non-spawning behavior")
      assert(#spawned == dispatched_before, suffix .. " must not dispatch")
    end
  end
end

-- Provider prerequisites gate spawn before session-type resolution. Every declaration shape a
-- step can carry -- including the malformed ones the published schema now forbids -- has to be
-- checked, never treated as "nothing declared". `provider_dependencies` is not a Hub Lua
-- capability, so any named prerequisite is unconditionally unavailable and every case below
-- must block; the final case proves the gate did not become universal.
do
  local cases = {
    { suffix = "named-object", declaration = { { dependency = "github_auth", provider = "github" } }, blocks = true },
    { suffix = "capability-object", declaration = { { capability = "github.auth" } }, blocks = true },
    { suffix = "provider-only", declaration = { { provider = "github" } }, blocks = true },
    { suffix = "empty-object", declaration = { {} }, blocks = true },
    { suffix = "string", declaration = { "github_auth" }, blocks = true },
    { suffix = "empty-string", declaration = { "" }, blocks = true },
    { suffix = "non-entry", declaration = { 7 }, blocks = true },
    { suffix = "undeclared", declaration = nil, blocks = false },
  }
  for _, case in ipairs(cases) do
    local id = "provider-" .. case.suffix
    assert(tools["project_pipelines.create_pipeline"]({
      id = "pipeline-" .. id, name = "Provider " .. case.suffix,
      steps = { {
        id = id .. "-step", name = "Provider step", kind = "pty", session_type_id = "provider-session-type",
        required_provider_dependencies = case.declaration,
      } },
    }).ok)
    assert(tools["project_pipelines.create_ticket"]({
      id = "ticket-" .. id, project_id = "project-one", target_id = "target-one", title = "Provider " .. case.suffix,
    }).ok)
    assert(tools["project_pipelines.start_run"]({
      id = "run-" .. id, ticket_id = "ticket-" .. id, pipeline_id = "pipeline-" .. id,
    }).ok)
    local dispatched_before = #spawned
    local activation = tools["project_pipelines.spawn_ticket_session"]({
      run_id = "run-" .. id, request_id = "request-" .. id,
    })
    if case.blocks then
      assert(not activation.ok and activation.error.code == "provider_dependency_missing",
        "declaration shape " .. case.suffix .. " bypassed the provider gate")
      assert(#spawned == dispatched_before, "declaration shape " .. case.suffix .. " dispatched a spawn")
      local blocked_request = context_for("run-" .. id).session_requests[1]
      assert(blocked_request and blocked_request.status == "blocked" and not blocked_request.session_id,
        "declaration shape " .. case.suffix .. " did not persist a blocked request")
    else
      assert(activation.ok and #spawned == dispatched_before + 1,
        "a step declaring no prerequisite must still spawn")
    end
  end
end

-- The fail-closed ticket-dependency gate and session-type resolution now live in the same
-- activation path and merged without a textual conflict, so no review has ever seen them
-- executed together. Cross them explicitly: which gate wins, what each one persists, and
-- that the two blocked vocabularies are each counted exactly once by the operator queue.
do
  assert(tools["project_pipelines.create_pipeline"]({
    id = "pipeline-crossed", name = "Crossed gates",
    steps = {
      { id = "crossed-plan", name = "Plan", allows_open_ticket_dependencies = true, on_approved_step_id = "crossed-implement" },
      { id = "crossed-implement", name = "Implement", kind = "pty", session_type_id = "crossed-session-type" },
      { id = "crossed-unresolvable", name = "Unresolvable", kind = "pty" },
      {
        id = "crossed-exempt", name = "Exempt", kind = "pty", allows_open_ticket_dependencies = true,
        session_type_id = "crossed-exempt-session-type",
      },
    },
  }).ok)
  local function start_crossed_run(prefix, blocker_id)
    assert(tools["project_pipelines.create_ticket"]({
      id = prefix .. "-ticket", project_id = "project-one", target_id = "target-one", title = prefix,
    }).ok)
    assert(tools["project_pipelines.start_run"]({
      id = prefix .. "-run", ticket_id = prefix .. "-ticket", pipeline_id = "pipeline-crossed",
    }).ok)
    if blocker_id then
      assert(tools["project_pipelines.create_ticket"]({
        id = blocker_id, project_id = "project-one", title = blocker_id,
      }).ok)
      assert(tools["project_pipelines.add_ticket_dependency"]({
        id = prefix .. "-row", ticket_id = prefix .. "-ticket", dependency_ticket_id = blocker_id,
      }).ok)
    end
    return prefix .. "-run"
  end

  -- (a) An open dependency wins over session-type resolution and leaves no session-type trace.
  local gated_run = start_crossed_run("crossed", "crossed-blocker")
  local dispatched = #spawned
  local gated = tools["project_pipelines.spawn_ticket_session"]({
    run_id = gated_run, step_id = "crossed-implement", request_id = "crossed-gated",
  })
  assert(not gated.ok and gated.error.code == "ticket_dependencies_unmet",
    "the dependency gate must decide before session-type resolution")
  local gated_context = context_for(gated_run)
  assert(gated_context.run.blocked_transition and gated_context.run.blocked_transition.step_id == "crossed-implement")
  assert(#gated_context.session_requests == 0, "a dependency-blocked PTY step must persist no session request")
  assert(gated_context.run.blocked_reason == nil and gated_context.run.diagnostic == nil,
    "the dependency gate must not write session-type diagnostics")
  assert(count_events(gated_run, "session_type_spawn_blocked") == 0)
  assert(#spawned == dispatched, "a dependency-blocked PTY step must not dispatch")

  -- (c) With dependencies satisfied, an unresolvable session type blocks in the other vocabulary.
  local unresolvable_run = start_crossed_run("crossed-unresolved")
  local unresolvable = tools["project_pipelines.spawn_ticket_session"]({
    run_id = unresolvable_run, step_id = "crossed-unresolvable", request_id = "crossed-unresolved-request",
  })
  assert(not unresolvable.ok and unresolvable.error.code == "session_type_id_required")
  local unresolvable_context = context_for(unresolvable_run)
  assert(#unresolvable_context.session_requests == 1 and unresolvable_context.session_requests[1].status == "blocked")
  assert(unresolvable_context.run.blocked_reason and unresolvable_context.run.diagnostic.code == "session_type_id_required")
  assert(unresolvable_context.run.blocked_transition == nil,
    "a session-type block must not masquerade as a dependency hold")
  assert(count_events(unresolvable_run, "session_type_spawn_blocked") == 1)
  assert(#spawned == dispatched, "a blocked session-type resolution must not dispatch")

  -- (d) Both hold vocabularies are live at once; each run is queued exactly once and the
  -- rendered metric still equals the rendered rows.
  local crossed_nodes = collect_nodes(home_surface())
  local crossed_list = crossed_nodes["project-pipelines-needs-attention-list"]
  local function attention_rows(node_id)
    local total = 0
    for _, row in ipairs(crossed_list.children or {}) do
      if row.id == node_id then total = total + 1 end
    end
    return total
  end
  assert(attention_rows("project-pipelines-attention-dependencies-" .. gated_run) == 1,
    "a dependency-held run must be queued exactly once")
  assert(attention_rows("project-pipelines-attention-session-crossed-unresolved-request") == 1,
    "a session-type-blocked request must be queued exactly once")
  assert(crossed_nodes["project-pipelines-metric-attention"].props.value == tostring(#crossed_list.children),
    "the needs-attention metric must equal the rendered rows across both hold vocabularies")

  -- (b) Clearing the dependency lets the same step spawn exactly once; retrying reuses it.
  assert(tools["project_pipelines.update_ticket"]({ ticket_id = "crossed-blocker", status = "closed" }).ok)
  local cleared = tools["project_pipelines.spawn_ticket_session"]({
    run_id = gated_run, step_id = "crossed-implement", request_id = "crossed-spawn",
  })
  assert(cleared.ok and #spawned == dispatched + 1, "a cleared dependency must let the same PTY step spawn once")
  assert(spawned[#spawned].session_type_id == "crossed-session-type")
  local cleared_context = context_for(gated_run)
  assert(cleared_context.run.blocked_transition == nil, "activation must consume the dependency hold record")
  assert(#cleared_context.session_requests == 1 and cleared_context.session_requests[1].status == "spawn_requested")
  local reactivated = tools["project_pipelines.spawn_ticket_session"]({
    run_id = gated_run, step_id = "crossed-implement", request_id = "crossed-spawn",
  })
  assert(reactivated.ok and reactivated.activation.id == "crossed-spawn", "repeat activation must reuse the request")
  assert(#spawned == dispatched + 1, "repeat activation must not dispatch again")
  assert(#context_for(gated_run).session_requests == 1)

  -- (e) An exempt PTY step bypasses the dependency gate and still resolves a session type.
  local exempt_run = start_crossed_run("crossed-exempt-run-owner", "crossed-exempt-blocker")
  local exempt = tools["project_pipelines.spawn_ticket_session"]({
    run_id = exempt_run, step_id = "crossed-exempt", request_id = "crossed-exempt-request",
  })
  assert(exempt.ok and spawned[#spawned].session_type_id == "crossed-exempt-session-type",
    "an exempt PTY step must bypass the dependency gate and still resolve a session type")
  assert(#spawned == dispatched + 2)
  assert(context_for(exempt_run).run.blocked_transition == nil)
end

