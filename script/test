}).ok)
assert(tools["project_pipelines.add_ticket_dependency"]({
  id = "waiting-recovery-row", ticket_id = "waiting-recovery-ticket",
  dependency_ticket_id = "waiting-recovery-dependency",
}).ok)
local recovered_wait = tools["project_pipelines.request_step_advance"]({
  run_id = "waiting-recovery-run", request_id = "waiting-recovery-advance",
})
assert(not recovered_wait.ok and recovered_wait.error.code == "ticket_dependencies_unmet",
  "pending correlated recovery must rerun dependency preflight")
local recovery_context = context_for("waiting-recovery-run")
assert(recovery_context.run.current_step_id == "waiting-plan-review" and #recovery_context.run_steps == 1)
local recovery_scenario = {
  run_id = "waiting-recovery-run",
  run_step_id = recovery_started.run_step.id,
}
assert(tools["project_pipelines.update_ticket"]({ ticket_id = "waiting-recovery-dependency", status = "closed" }).ok)
assert_woken_once(recovery_scenario)
local duplicate_recovery = tools["project_pipelines.request_step_advance"]({
  run_id = "waiting-recovery-run", request_id = "waiting-recovery-advance",
})
assert(duplicate_recovery.ok and duplicate_recovery.step_id == "waiting-implement")
assert_woken_once(recovery_scenario)

