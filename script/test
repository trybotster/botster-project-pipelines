-- BEGIN v3 migration seed fixture
-- Free-text prose the migrator must never rewrite. Seeded and asserted through the same
-- constants so the byte-for-byte check stays outside the repository legacy-vocabulary guard.
local LEGACY_PROSE = {
  request_summary = "Keep session template prose byte-for-byte",
  request_prompt = "Keep Session template evidence byte-for-byte",
  event_message = "Keep session template event prose byte-for-byte",
}
-- Agent-authored payloads that merely LOOK like package identity. A key name inside caller
-- context, metadata, or a Hub result means nothing to this package and must survive intact.
-- The key names live here so the assertions below can address them without writing the
-- retired vocabulary outside this fence.
local AUTHORED_KEYS = { "template_id", "template_name", "session_capability" }
-- Every selector key the pre-cut package could have written onto a record it owns. Assertions
-- address them from here so the retired vocabulary stays inside this fence.
local RETIRED_KEYS = {
  "session_template_id", "template_id",
  "session_template_name", "template_name",
  "session_template_capability", "session_capability",
  "template_selector",
}
local AUTHORED = {
  metadata_identity = "authored-identity-value",
  metadata_capability = "authored-capability-value",
  context_note = "authored selector-shaped evidence",
  result_extra = "authored nested result value",
  event_metadata = "authored event metadata value",
}
durable_store = {
  ["v3/pipeline_definitions/legacy-custom"] = {
    key = "v3/pipeline_definitions/legacy-custom", schema_version = 3, revision = 1,
    payload = {
      id = "legacy-custom", name = "Legacy custom", steps = {
        { id = "legacy-name-step", name = "Legacy name", position = 1, kind = "pty", session_template_name = "Old display name" },
        { id = "legacy-exact-step", name = "Legacy exact", position = 2, kind = "pty", session_template_id = "exact-session-type" },
        { id = "legacy-capability-step", name = "Legacy capability", position = 3, kind = "pty", session_template_capability = "old.capability" },
      },
    },
  },
  ["v3/session_requests/legacy-request"] = {
    key = "v3/session_requests/legacy-request", schema_version = 3, revision = 1,
    payload = {
      id = "legacy-request", run_id = "legacy-run", step_id = "legacy-exact-step", status = "spawn_requested",
      prompt_summary = LEGACY_PROSE.request_summary,
      template_id = "exact-session-type",
      request = {
        template_id = "exact-session-type",
        context = {
          prompt = LEGACY_PROSE.request_prompt,
          note = AUTHORED.context_note,
          metadata = {
            [AUTHORED_KEYS[1]] = AUTHORED.metadata_identity,
            [AUTHORED_KEYS[3]] = AUTHORED.metadata_capability,
          },
        },
      },
      result = { template_id = "exact-session-type", extra = { [AUTHORED_KEYS[2]] = AUTHORED.result_extra } },
    },
  },
  -- The real blocked-request envelope. The pre-cut writer stored one diagnostic table in two
  -- durable slots: session_request.diagnostic and result.error. Once persisted they are
  -- independent copies, so both must land on the authoritative contract.
  ["v3/session_requests/legacy-blocked"] = {
    key = "v3/session_requests/legacy-blocked", schema_version = 3, revision = 1,
    payload = {
      id = "legacy-blocked", run_id = "legacy-run", step_id = "legacy-name-step", status = "blocked",
      template_selector = { kind = "name", template_name = "Old display name" },
      request = { target_id = "target-one", context = { prompt = LEGACY_PROSE.request_prompt } },
      result = {
        ok = false,
        error = {
          status = "blocked",
          code = "session_template_unavailable",
          message = "no hub session template matched selector",
          template_selector = { kind = "name", template_name = "Old display name" },
        },
        note = AUTHORED.result_extra,
      },
      diagnostic = {
        status = "blocked",
        code = "session_template_unavailable",
        message = "no hub session template matched selector",
        template_selector = { kind = "name", template_name = "Old display name" },
      },
    },
  },
  ["v3/events/legacy-event"] = {
    key = "v3/events/legacy-event", schema_version = 3, revision = 1,
    payload = {
      id = "legacy-event", kind = "session_template_spawn_requested", message = LEGACY_PROSE.event_message,
      payload = {
        template_id = "exact-session-type",
        template_selector = { kind = "id", value = "exact-session-type" },
        status = "spawn_requested",
        diagnostic = { code = "session_template_unavailable", message = "session template selector is unavailable" },
        context = { metadata = { [AUTHORED_KEYS[2]] = AUTHORED.event_metadata } },
      },
    },
  },
  ["v3/runs/legacy-run"] = {
    key = "v3/runs/legacy-run", schema_version = 3, revision = 1,
    payload = {
      id = "legacy-run", ticket_id = "legacy-ticket", pipeline_definition_id = "legacy-custom",
      current_step_id = "legacy-exact-step", status = "blocked",
      diagnostic = {
        code = "session_template_unavailable",
        message = "session template selector is unavailable",
        template_selector = { name = "Old display name" },
      },
      blocked_reason = "no hub session template matched selector",
    },
  },
}
-- END v3 migration seed fixture

fail_batch_key_prefix = "v4/"
local failed_migration = pcall(dofile, "plugin.lua")
assert(not failed_migration, "injected v3 migration failure must stop package load")
assert(durable_store["v3/pipeline_definitions/legacy-custom"], "failed migration must preserve every v3 record")
assert(not durable_store["v4/pipeline_definitions/legacy-custom"], "failed migration must publish no v4 record")

fail_batch_key_prefix = nil
local migrated_plugin = dofile("plugin.lua")
assert(not durable_store["v3/pipeline_definitions/legacy-custom"], "successful migration must remove v3 records")
assert(durable_store["v4/pipeline_definitions/legacy-custom"].schema_version == 4, "migrated record must use schema v4")
local migrated_tools = {}
for _, descriptor in ipairs(migrated_plugin.tools) do migrated_tools[descriptor.name] = descriptor.call end
local migrated_context = migrated_tools["project_pipelines.current_context"]({})
local migrated_pipeline
for _, pipeline in ipairs(migrated_context.pipeline_definitions) do
  if pipeline.id == "legacy-custom" then migrated_pipeline = pipeline end
end
assert(migrated_pipeline, "migrated custom pipeline missing")
assert(migrated_pipeline.steps[1].session_type_id_required == true, "name-only selector must require operator repair")
assert(migrated_pipeline.steps[2].session_type_id == "exact-session-type", "exact legacy id must rewrite mechanically")
assert(migrated_pipeline.steps[3].session_type_id_required == true, "capability-only selector must require operator repair")
local migrated_request, migrated_blocked
for _, request in ipairs(migrated_context.session_requests) do
  if request.id == "legacy-request" then migrated_request = request end
  if request.id == "legacy-blocked" then migrated_blocked = request end
end
assert(migrated_request and migrated_blocked, "migrated session requests missing")
assert(migrated_request.session_type_id == "exact-session-type")
assert(migrated_request.request.session_type_id == "exact-session-type")
assert(migrated_request.result.session_type_id == "exact-session-type")
assert(migrated_request.prompt_summary == LEGACY_PROSE.request_summary, "migration rewrote human-authored prompt summary prose")
assert(migrated_request.request.context.prompt == LEGACY_PROSE.request_prompt, "migration rewrote durable request prompt evidence")
-- The migrator rewrites package-owned identity at known structural paths only. A legacy-looking
-- key inside caller context, metadata, or a Hub result is authored evidence, not package
-- identity, and deleting or renaming it would silently corrupt the durable record.
assert(migrated_request.request.context.note == AUTHORED.context_note, "migration rewrote agent-authored context")
assert(migrated_request.request.context.metadata[AUTHORED_KEYS[1]] == AUTHORED.metadata_identity,
  "migration rewrote agent-authored metadata")
assert(migrated_request.request.context.metadata[AUTHORED_KEYS[3]] == AUTHORED.metadata_capability,
  "migration rewrote agent-authored metadata")
assert(migrated_request.result.extra[AUTHORED_KEYS[2]] == AUTHORED.result_extra,
  "migration rewrote a nested Hub result payload")
for _, key in ipairs(RETIRED_KEYS) do
  assert(migrated_request[key] == nil, "package-owned selector survived migration: " .. key)
  assert(migrated_request.request[key] == nil, "package-owned request selector survived migration: " .. key)
  assert(migrated_request.result[key] == nil, "package-owned result selector survived migration: " .. key)
  assert(migrated_blocked[key] == nil, "blocked request selector survived migration: " .. key)
end
-- Both durable copies of a blocked activation's diagnostic must land on the authoritative
-- contract. A consumer reading result.error would otherwise still see the retired one.
for _, diagnostic in ipairs({ migrated_blocked.diagnostic, migrated_blocked.result.error }) do
  assert(diagnostic.code == "session_type_unavailable", "blocked diagnostic code survived on the retired contract")
  assert(diagnostic.message == "no hub session type matched id", "blocked diagnostic message survived on the retired contract")
  for _, key in ipairs(RETIRED_KEYS) do
    assert(diagnostic[key] == nil, "blocked diagnostic kept a retired selector: " .. key)
  end
  assert(diagnostic.status == "blocked", "blocked diagnostic lost its status")
end
assert(migrated_blocked.result.ok == false, "migration rewrote the result envelope")
assert(migrated_blocked.result.note == AUTHORED.result_extra, "migration rewrote unrelated result payload")
assert(migrated_blocked.session_type_id == nil, "an unmappable selector must not synthesize an identity")
assert(migrated_blocked.request.context.prompt == LEGACY_PROSE.request_prompt, "migration rewrote blocked request evidence")
local migrated_event
for _, event in ipairs(migrated_context.events) do
  if event.id == "legacy-event" then migrated_event = event end
end
assert(migrated_event and migrated_event.kind == "session_type_spawn_requested")
assert(migrated_event.message == LEGACY_PROSE.event_message, "migration rewrote durable event prose")
assert(migrated_event.payload.session_type_id == "exact-session-type", "event identity did not migrate")
assert(migrated_event.payload.template_selector == nil, "event selector survived migration")
assert(migrated_event.payload.diagnostic.code == "session_type_unavailable")
assert(migrated_event.payload.diagnostic.message == "session type id is unavailable")
assert(migrated_event.payload.context.metadata[AUTHORED_KEYS[2]] == AUTHORED.event_metadata,
  "migration rewrote agent-authored event context")
local migrated_run
for _, run in ipairs(migrated_context.runs) do if run.id == "legacy-run" then migrated_run = run end end
assert(migrated_run and migrated_run.diagnostic.code == "session_type_unavailable")
assert(migrated_run.diagnostic.message == "session type id is unavailable")
assert(migrated_run.diagnostic.template_selector == nil)
assert(migrated_run.blocked_reason == "no hub session type matched id")

assert(migrated_tools["project_pipelines.create_project"]({
  id = "legacy-project", name = "Legacy project", target_id = "target-one",
}).ok)
assert(migrated_tools["project_pipelines.create_ticket"]({
  id = "legacy-ticket", project_id = "legacy-project", target_id = "target-one", title = "Repair legacy selector",
}).ok)
assert(migrated_tools["project_pipelines.start_run"]({
  id = "legacy-run-repair", ticket_id = "legacy-ticket", pipeline_id = "legacy-custom",
}).ok)
default_session_type_id = "device-default-must-not-satisfy-repair"
local unmappable = migrated_tools["project_pipelines.spawn_ticket_session"]({
  run_id = "legacy-run-repair", request_id = "legacy-unmappable",
})
assert(not unmappable.ok and unmappable.error.code == "session_type_id_required", "unmappable selectors must fail loudly")
local repaired_step = migrated_tools["project_pipelines.update_step"]({
  step_id = "legacy-name-step", session_type_id = "operator-repaired-type",
})
assert(repaired_step.ok and repaired_step.step.session_type_id_required == nil)
local repaired_legacy = migrated_tools["project_pipelines.spawn_ticket_session"]({
  run_id = "legacy-run-repair", request_id = "legacy-repaired",
})
assert(repaired_legacy.ok and spawned[#spawned].session_type_id == "operator-repaired-type")
default_session_type_id = nil

local settled_revision = durable_store["v4/pipeline_definitions/legacy-custom"].revision
local restarted_migration = dofile("plugin.lua")
local restarted_migration_tools = {}
for _, descriptor in ipairs(restarted_migration.tools) do restarted_migration_tools[descriptor.name] = descriptor.call end
local restarted_legacy = restarted_migration_tools["project_pipelines.list_pipelines"]({}).pipelines
local persisted_repair
for _, pipeline in ipairs(restarted_legacy) do
  if pipeline.id == "legacy-custom" then persisted_repair = pipeline.steps[1].session_type_id end
end
assert(persisted_repair == "operator-repaired-type", "v4 repair must survive restart")
assert(durable_store["v4/pipeline_definitions/legacy-custom"].revision == settled_revision,
  "restart must not rewrite settled v4 records")
for key in pairs(durable_store) do
  assert(key:sub(1, 3) ~= "v3/", "restart must not resurrect a legacy namespace record: " .. key)
end

;(function()
local function reset_emits()
  emit_stub.events = {}
end
local function last_opened_emit()
  return emit_stub.events[#emit_stub.events]
end

local function question_opened_payload_valid(payload, question)
  assert(payload.question_id == question.id, "question_id")
  assert(payload.kind == question.kind, "kind")
  assert(type(payload.notice) == "string" and payload.notice ~= "", "notice")
  assert(utf8.len(payload.notice) <= 280, "notice length")
  assert(payload.blocking == (question.blocking == true), "blocking")
  if question.run_id then
    assert(payload.run_id == question.run_id, "run_id")
  else
    assert(payload.run_id == nil, "run_id omitted")
  end
  if question.ticket_id then
    assert(payload.ticket_id == question.ticket_id, "ticket_id")
  else
    assert(payload.ticket_id == nil, "ticket_id omitted")
  end
  if question.step_id then
    assert(payload.step_id == question.step_id, "step_id")
  else
    assert(payload.step_id == nil, "step_id omitted")
  end
  assert(payload.emit_status == nil, "emit status must not be persisted on the payload")
end

assert(tools["project_pipelines.create_project"]({
  id = "project-question-opened", name = "Question opened", target_id = "target-one",
}).ok)
assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-question-opened", name = "Question opened",
  steps = {
    { id = "step-one", name = "One", next_step_id = "step-two" },
    { id = "step-two", name = "Two" },
  },
}).ok)
assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-question-opened", project_id = "project-question-opened", title = "Question opened",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-question-opened", ticket_id = "ticket-question-opened", pipeline_id = "pipeline-question-opened",
}).ok)

reset_emits()
local opened = tools["project_pipelines.ask_human"]({
  run_id = "run-question-opened",
  ticket_id = "ticket-question-opened",
  step_id = "step-one",
  blocking = true,
  question = "Continue?",
})
assert(opened.ok)
assert(#emit_stub.events == 1 and emit_stub.events[1].name == "question.opened")
question_opened_payload_valid(emit_stub.events[1].payload, opened.question)
assert(opened.question.question == "Continue?")
assert(opened.question.emit_status == nil)
local opened_context = tools["project_pipelines.current_context"]({ run_id = "run-question-opened" })
assert(#opened_context.questions == 1 and opened_context.questions[1].id == opened.question.id)
assert(count_events("run-question-opened", "question_asked") == 1)
local opened_snapshot = entity_providers["project-pipelines.question"]({ entity_type = "project-pipelines.question" })
local opened_row
for _, item in ipairs(opened_snapshot.items) do
  if item.id == opened.question.id then opened_row = item end
end
assert(opened_row and opened_row.question == "Continue?", "entity snapshot must keep the durable question")

reset_emits()
local agent_opened = tools["project_pipelines.ask_agent"]({
  run_id = "run-question-opened",
  ticket_id = "ticket-question-opened",
  question = "Review?",
})
assert(agent_opened.ok)
assert(#emit_stub.events == 1 and emit_stub.events[1].payload.kind == "agent")
question_opened_payload_valid(emit_stub.events[1].payload, agent_opened.question)

reset_emits()
assert(tools["project_pipelines.escalate_question"]({ question_id = agent_opened.question.id }).question.kind == "human")
assert(#emit_stub.events == 0, "escalate_question must not emit question.opened")
reset_emits()
assert(tools["project_pipelines.answer_question"]({
  question_id = agent_opened.question.id, answer = "Reviewed",
}).ok)
assert(#emit_stub.events == 0, "answer_question must not emit question.opened")

fail_batch_key_prefix = "v4/questions/"
reset_emits()
local persist_failed = tools["project_pipelines.ask_human"]({
  id = "question-persist-fail",
  run_id = "run-question-opened",
  ticket_id = "ticket-question-opened",
  question = "Must not emit",
})
fail_batch_key_prefix = nil
assert(not persist_failed.ok and persist_failed.error.code == "persist_failed")
assert(#emit_stub.events == 0, "failed persist must emit nothing")
local after_persist_fail = tools["project_pipelines.current_context"]({ run_id = "run-question-opened" })
for _, row in ipairs(after_persist_fail.questions) do
  assert(row.id ~= "question-persist-fail", "failed persist must not leave a question row")
end

local function assert_nonfatal_emit(label, configure)
  configure()
  reset_emits()
  local result = tools["project_pipelines.ask_human"]({
    id = "question-" .. label,
    run_id = "run-question-opened",
    ticket_id = "ticket-question-opened",
    question = "Non-fatal " .. label,
  })
  emit_stub.status = "accepted"
  emit_stub.throw = false
  assert(result.ok, label .. " must keep ask_human ok: " .. tostring(result and result.error and result.error.code))
  assert(result.question and result.question.id == "question-" .. label, label .. " id mismatch")
  assert(result.question.emit_status == nil, label .. " stored emit_status")
  assert(result.question.event_status == nil, label .. " stored event_status")
  local context = tools["project_pipelines.current_context"]({ run_id = "run-question-opened" })
  local found
  for _, row in ipairs(context.questions) do
    if row.id == result.question.id then found = row end
  end
  assert(found and found.question == "Non-fatal " .. label, label .. " must keep the durable question")
  local snapshot = entity_providers["project-pipelines.question"]({ entity_type = "project-pipelines.question" })
  local snap_row
  for _, item in ipairs(snapshot.items) do
    if item.id == result.question.id then snap_row = item end
  end
  assert(snap_row, label .. " must remain visible through entity_provider")
end

assert_nonfatal_emit("shed-full", function() emit_stub.status = "shed_full" end)
assert_nonfatal_emit("rejected-invalid", function() emit_stub.status = "rejected_invalid" end)
assert_nonfatal_emit("throw", function() emit_stub.throw = true end)

local accent = "\195\169"
local long_question = string.rep("x", 279) .. accent .. string.rep("y", 40)
local byte_cut = long_question:sub(1, 280)
assert(utf8.len(byte_cut) == nil, "byte :sub(1,280) must be the wrong cut across U+00E9")
reset_emits()
local utf8_opened = tools["project_pipelines.ask_human"]({
  id = "question-utf8-boundary",
  run_id = "run-question-opened",
  ticket_id = "ticket-question-opened",
  question = long_question,
})
assert(utf8_opened.ok)
assert(utf8_opened.question.question == long_question)
assert(#emit_stub.events == 1)
local notice = emit_stub.events[1].payload.notice
assert(utf8.len(notice) == 280, "notice must be 280 Unicode characters")
assert(notice == string.rep("x", 279) .. accent)
question_opened_payload_valid(emit_stub.events[1].payload, utf8_opened.question)

reset_emits()
local invalid_question = "hello" .. string.char(0xC3)
local invalid_opened = tools["project_pipelines.ask_human"]({
  id = "question-invalid-utf8",
  run_id = "run-question-opened",
  ticket_id = "ticket-question-opened",
  question = invalid_question,
})
assert(invalid_opened.ok)
assert(invalid_opened.question.question == invalid_question)
assert(#emit_stub.events == 1)
assert(emit_stub.events[1].payload.notice == "?")
assert(utf8.len(emit_stub.events[1].payload.notice) == 1)

assert(last_opened_emit().name == "question.opened")
end)()

print("project-pipelines authoritative package checks passed")
