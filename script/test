-- Reproduce the observed production/import shape. The normalized dependency row
-- is durable and the ticket payload has no embedded dependency mirror.
durable_store["v3/tickets/durable-dependent"].payload.dependency_ticket_ids = nil
durable_store["v3/ticket_dependencies/durable-dependency-row"] = {
  key = "v3/ticket_dependencies/durable-dependency-row",
  schema_version = 3,
  revision = 1,
  payload = {
    id = "durable-dependency-row",
    ticket_id = "durable-dependent",
    depends_on_ticket_id = "durable-dependency-open",
  },
}
local durable_dependency_plugin = dofile("plugin.lua")
local durable_dependency_tools = {}
for _, descriptor in ipairs(durable_dependency_plugin.tools) do
  durable_dependency_tools[descriptor.name] = descriptor.call
end
assert(durable_dependency_tools["project_pipelines.submit_review"]({
  run_id = "run-durable-dependency",
  run_step_id = durable_dependency_run.run_step.id,
  step_id = "plan-review",
  verdict = "approved",
}).ok)
local durable_dependency_advance = durable_dependency_tools["project_pipelines.request_step_advance"]({
  run_id = "run-durable-dependency",
  request_id = "advance-durable-dependency",
})
assert(not durable_dependency_advance.ok and durable_dependency_advance.error.code == "ticket_dependencies_unmet",
  "normalized durable dependency must block approved Plan Review advancement")
local durable_waiting_context = durable_dependency_tools["project_pipelines.current_context"]({ run_id = "run-durable-dependency" })
assert(durable_waiting_context.run.current_step_id == "plan-review")
assert(durable_waiting_context.run.current_run_step_id == durable_dependency_run.run_step.id)
assert(durable_waiting_context.run.waiting_transition.source_run_step_id == durable_dependency_run.run_step.id)
assert(durable_waiting_context.run.waiting_transition.target_step_id == "implement")
assert(#durable_waiting_context.run_steps == 1, "waiting must not create the target run-step")

