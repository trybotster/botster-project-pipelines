local review = tools["project_pipelines.submit_review"]({
  run_id = "run-atomic", run_step_id = started.run_step.id, step_id = "step-one", verdict = "approved",
  findings = { { id = "finding-one", title = "Carry forward", severity = "medium" } },
})
assert(review.ok)
assert(tools["project_pipelines.resolve_finding"]({ finding_id = "finding-one", resolution = "Verified" }).ok)
local gate_blocked = tools["project_pipelines.request_step_advance"]({
  run_id = "run-atomic", request_id = "advance-before-gate",
})
