  id = "run-durable-dependency", ticket_id = "durable-dependent", pipeline_id = "pipeline-durable-dependency",
})
assert(durable_dependency_run.ok)

-- Reproduce the observed production/import shape. The normalized dependency row
-- is durable and the ticket payload has no embedded dependency mirror.
durable_store["v4/tickets/durable-dependent"].payload.dependency_ticket_ids = nil
durable_store["v4/ticket_dependencies/durable-dependency-row"] = {
  key = "v4/ticket_dependencies/durable-dependency-row",
  schema_version = 4,
  revision = 1,
  payload = {
    id = "durable-dependency-row",
    ticket_id = "durable-dependent",
    depends_on_ticket_id = "durable-dependency-open",
  },
}
local durable_dependency_plugin = dofile("plugin.lua")
local durable_dependency_tools = {}
for _, descriptor in ipairs(durable_dependency_plugin.tools) do
  durable_dependency_tools[descriptor.name] = descriptor.call
end
assert(durable_dependency_tools["project_pipelines.submit_review"]({
  run_id = "run-durable-dependency",
  run_step_id = durable_dependency_run.run_step.id,
  step_id = "plan-review",
  verdict = "approved",
}).ok)
local durable_dependency_advance = durable_dependency_tools["project_pipelines.request_step_advance"]({
  run_id = "run-durable-dependency",
  request_id = "advance-durable-dependency",
})
assert(not durable_dependency_advance.ok and durable_dependency_advance.error.code == "ticket_dependencies_unmet",
  "normalized durable dependency must block approved Plan Review advancement")
local durable_waiting_context = durable_dependency_tools["project_pipelines.current_context"]({ run_id = "run-durable-dependency" })
assert(durable_waiting_context.run.current_step_id == "plan-review")
assert(durable_waiting_context.run.current_run_step_id == durable_dependency_run.run_step.id)
assert(durable_waiting_context.run.waiting_transition.source_run_step_id == durable_dependency_run.run_step.id)
assert(durable_waiting_context.run.waiting_transition.target_step_id == "implement")
assert(#durable_waiting_context.run_steps == 1, "waiting must not create the target run-step")

local create_descriptor = descriptors["project_pipelines.create_ticket"]
assert(create_descriptor.input_schema.properties.dependency_ticket_ids.type == "array")
assert(create_descriptor.input_schema.properties.dependency_ticket_ids.items.type == "string")
assert(create_descriptor.description:find("atomically registered as normalized blocking dependency rows", 1, true))
local authored_dependency_ticket = tools["project_pipelines.create_ticket"]({
  id = "authored-dependencies", project_id = "project-one", title = "Authored dependencies",
  dependency_ticket_ids = { "durable-dependency-open", "durable-dependency-open" },
})
assert(authored_dependency_ticket.ok and authored_dependency_ticket.ticket.dependency_ticket_ids == nil)
local authored_rows = tools["project_pipelines.list_ticket_dependencies"]({ ticket_id = "authored-dependencies" }).dependencies
assert(#authored_rows == 1 and authored_rows[1].depends_on_ticket_id == "durable-dependency-open")
durable_store["v4/tickets/authored-dependencies"].payload.dependency_ticket_ids = { "non-authoritative-mirror" }
assert(tools["project_pipelines.get_ticket"]({ ticket_id = "authored-dependencies" }).ticket.dependency_ticket_ids == nil)
assert(tools["project_pipelines.update_ticket"]({ ticket_id = "authored-dependencies", description = "Mirror removed" }).ok)
assert(durable_store["v4/tickets/authored-dependencies"].payload.dependency_ticket_ids == nil,
  "next atomic write must remove a non-authoritative ticket mirror")
local tickets_before_invalid_create = #tools["project_pipelines.list_tickets"]({}).tickets
local invalid_authored_dependency = tools["project_pipelines.create_ticket"]({
  id = "invalid-authored-dependencies", project_id = "project-one", title = "Invalid authored dependencies",
  dependency_ticket_ids = { "durable-dependency-open", "missing-authored-dependency" },
})
assert(not invalid_authored_dependency.ok and invalid_authored_dependency.error.code == "not_found")
assert(#tools["project_pipelines.list_tickets"]({}).tickets == tickets_before_invalid_create,
  "invalid authored dependencies must create neither ticket nor normalized rows")
assert(#tools["project_pipelines.list_ticket_dependencies"]({ ticket_id = "invalid-authored-dependencies" }).dependencies == 0)
fail_batch_key_prefix = "v4/tickets/atomic-authored-dependencies"
local failed_authored_dependency = tools["project_pipelines.create_ticket"]({
  id = "atomic-authored-dependencies", project_id = "project-one", title = "Atomic authored dependencies",
  dependency_ticket_ids = { "durable-dependency-open" },
})
assert(not failed_authored_dependency.ok and failed_authored_dependency.error.code == "persist_failed")
fail_batch_key_prefix = nil
assert(#tools["project_pipelines.list_ticket_dependencies"]({ ticket_id = "atomic-authored-dependencies" }).dependencies == 0)
for _, existing_ticket in ipairs(tools["project_pipelines.list_tickets"]({}).tickets) do
  assert(existing_ticket.id ~= "atomic-authored-dependencies", "failed create must not persist the ticket")
end

assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-waiting-wakeup", name = "Waiting wakeup",
  steps = {
    {
      id = "waiting-plan-review", name = "Plan Review", allows_open_ticket_dependencies = true,
      on_approved_step_id = "waiting-implement",
    },
    {
      id = "waiting-implement", name = "Implement", kind = "pty",
      session_type_id = "codex-session-type",
    },
  },
}).ok)

local function context_for(run_id)
  return tools["project_pipelines.current_context"]({ run_id = run_id })
end

local function count_events(run_id, kind)
  local total = 0
  for _, event in ipairs(context_for(run_id).events) do
    if event.kind == kind then total = total + 1 end
  end
  return total
end

local function create_waiting_scenario(prefix, blocker_count)
  assert(tools["project_pipelines.create_ticket"]({
    id = prefix .. "-ticket", project_id = "project-one", target_id = "target-one", title = prefix .. " ticket",
  }).ok)
  local started_waiting = tools["project_pipelines.start_run"]({
    id = prefix .. "-run", ticket_id = prefix .. "-ticket", pipeline_id = "pipeline-waiting-wakeup",
  })
  assert(started_waiting.ok)
  local dependency_ids = {}
  for index = 1, blocker_count do
    local dependency_id = prefix .. "-dependency-" .. tostring(index)
    table.insert(dependency_ids, dependency_id)
    assert(tools["project_pipelines.create_ticket"]({
      id = dependency_id, project_id = "project-one", title = dependency_id,
    }).ok)
    assert(tools["project_pipelines.add_ticket_dependency"]({
      id = prefix .. "-row-" .. tostring(index),
      ticket_id = prefix .. "-ticket", dependency_ticket_id = dependency_id,
    }).ok)
  end
  assert(tools["project_pipelines.submit_review"]({
    run_id = prefix .. "-run", run_step_id = started_waiting.run_step.id,
    step_id = "waiting-plan-review", verdict = "approved",
  }).ok)
  local spawned_before = #spawned
  local waiting = tools["project_pipelines.request_step_advance"]({
    run_id = prefix .. "-run", request_id = prefix .. "-advance",
  })
  assert(not waiting.ok and waiting.error.code == "ticket_dependencies_unmet")
  local waiting_context = context_for(prefix .. "-run")
  assert(waiting_context.run.current_step_id == "waiting-plan-review")
  assert(waiting_context.run.current_run_step_id == started_waiting.run_step.id)
  assert(waiting_context.run.waiting_transition.source_run_step_id == started_waiting.run_step.id)
  assert(#waiting_context.run.waiting_transition.unmet_dependencies == blocker_count)
  assert(#waiting_context.run_steps == 1 and #spawned == spawned_before)
  return {
    run_id = prefix .. "-run",
    ticket_id = prefix .. "-ticket",
    run_step_id = started_waiting.run_step.id,
    dependency_ids = dependency_ids,
    spawned_before = spawned_before,
  }
end

local function assert_woken_once(scenario)
  local context = context_for(scenario.run_id)
  assert(context.run.current_step_id == "waiting-implement")
  assert(context.run.waiting_transition == nil)
  assert(#context.run_steps == 2, "final clearance must create exactly one target run-step")
  local source_visits, target_visits = 0, 0
  for _, run_step in ipairs(context.run_steps) do
    if run_step.id == scenario.run_step_id then
      source_visits = source_visits + 1
      assert(run_step.status == "done")
    elseif run_step.step_id == "waiting-implement" then
      target_visits = target_visits + 1
      assert(run_step.status == "active")
    end
  end
  assert(source_visits == 1 and target_visits == 1)
end

