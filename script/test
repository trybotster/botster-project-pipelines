assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-two-step", name = "Two Step",
  steps = {
    { id = "step-one", name = "One", next_step_id = "step-two", gates = {
      { id = "gate-one", prompt = "Prove step one", required = true },
