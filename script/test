local handlers = {}
local entity_providers = {}
for _, handler in ipairs(plugin.handlers) do
  handlers[handler.descriptor_id] = handler.call
  if handler.kind == "entity_provider" then
    assert(handler.descriptor.entity_type == handler.descriptor_id)
    assert(handler.descriptor.id_field == "id")
    entity_providers[handler.descriptor_id] = handler.call
  end
end
local expected_entity_families = {
  "project", "project_target", "ticket", "ticket_dependency",
  "pipeline_definition", "run", "run_step", "gate_result", "review",
  "finding", "artifact", "checklist", "checklist_item", "question",
  "answer", "question_orchestrator", "pr_link", "event", "session_request",
}
local provider_count = 0
for _ in pairs(entity_providers) do provider_count = provider_count + 1 end
assert(provider_count == #expected_entity_families, "entity provider set must be closed")
for _, family in ipairs(expected_entity_families) do
  local entity_type = "project-pipelines." .. family
  local provider = entity_providers[entity_type]
  assert(provider, "missing entity provider " .. entity_type)
  local first_snapshot = provider({ entity_type = entity_type })
  local reconnect_snapshot = provider({ entity_type = entity_type })
  assert(first_snapshot.type == "entity_snapshot" and first_snapshot.entity_type == entity_type)
  assert(reconnect_snapshot.snapshot_seq == first_snapshot.snapshot_seq + 1, "reconnect snapshot must be fresh")
end
local run_snapshot = entity_providers["project-pipelines.run"]({ entity_type = "project-pipelines.run" })
assert(#run_snapshot.items == #tools["project_pipelines.current_context"]({}).runs, "run snapshot must match committed context")
