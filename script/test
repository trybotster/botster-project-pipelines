assert(updated_disposable.pipeline.description == "Updated" and updated_disposable.pipeline.archived_at == "archived")
assert(updated_disposable.pipeline.replacement_pipeline_id == "pipeline-new")
local disposable_step = tools["project_pipelines.create_step"]({
  pipeline_id = "pipeline-disposable", id = "step-disposable", name = "Disposable step",
})
assert(disposable_step.ok)
