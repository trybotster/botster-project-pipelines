assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-merge", project_id = "project-one", title = "Merge",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-merge", ticket_id = "ticket-merge", pipeline_id = "pipeline-two-step",
}).ok)
fail_batch_key_prefix = "v3/run_steps/"
assert(not tools["project_pipelines.request_merge"]({ run_id = "run-merge" }).ok)
local merge_failure = tools["project_pipelines.current_context"]({ run_id = "run-merge" })
assert(merge_failure.runs[1].status == "active")
fail_batch_key_prefix = nil
assert(tools["project_pipelines.link_pr"]({
  run_id = "run-merge", pr_url = "https://example.invalid/pr/1", repo = "example/repo", pr_number = 1,
  base_branch = "main", head_branch = "ticket-merge",
}).ok)
local pr_links = tools["project_pipelines.list_pr_links"]({ run_id = "run-merge", repo = "example/repo" }).pr_links
assert(#pr_links == 1 and tools["project_pipelines.get_pr_link"]({ pr_link_id = pr_links[1].id }).pr_link.id == pr_links[1].id)
assert(pr_links[1].base_branch == "main" and pr_links[1].head_branch == "ticket-merge")
assert(tools["project_pipelines.request_merge"]({ run_id = "run-merge" }).ok)

assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-spawn", name = "Spawn",
  steps = { { id = "spawn-step", name = "Spawn", kind = "pty", session_template_id = "template_codex" } },
}).ok)
assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-spawn", project_id = "project-one", target_id = "target-one", title = "Spawn",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-spawn", ticket_id = "ticket-spawn", pipeline_id = "pipeline-spawn",
}).ok)
local first_spawn = tools["project_pipelines.spawn_ticket_session"]({
  run_id = "run-spawn", request_id = "spawn-once", session_template_id = "template_codex",
})
assert(first_spawn.ok and #spawned == 1, "first correlated spawn must dispatch once")
local retry_spawn = tools["project_pipelines.retry_step_agent"]({ run_id = "run-spawn" })
assert(retry_spawn.ok and retry_spawn.activation.id == first_spawn.activation.id, "retry must reuse durable spawn result")
assert(#spawned == 1, "retry must not dispatch a second managed spawn")

assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-review-routing", name = "Review routing",
  steps = {
    { id = "implement", name = "Implement", next_step_id = "review" },
    { id = "review", name = "Review", next_step_id = "verify", on_approved_step_id = "verify",
      on_changes_requested_step_id = "implement", on_blocked_step_id = "implement" },
    { id = "verify", name = "Verify" },
  },
}).ok)
assert(tools["project_pipelines.create_ticket"]({
  id = "ticket-review-routing", project_id = "project-one", title = "Review routing",
}).ok)
assert(tools["project_pipelines.start_run"]({
  id = "run-review-routing", ticket_id = "ticket-review-routing", pipeline_id = "pipeline-review-routing",
}).ok)
assert(tools["project_pipelines.request_step_advance"]({ run_id = "run-review-routing" }).step_id == "review")
assert(tools["project_pipelines.submit_review"]({
  run_id = "run-review-routing", step_id = "review", verdict = "changes_required",
  findings = { { id = "finding-rework", title = "Rework", severity = "high" } },
}).ok)
local returned = tools["project_pipelines.request_step_advance"]({ run_id = "run-review-routing" })
assert(returned.ok and returned.step_id == "implement", "changes_required must route back to Implement")
assert(tools["project_pipelines.resolve_finding"]({ finding_id = "finding-rework", resolution = "fixed" }).ok)
assert(tools["project_pipelines.request_step_advance"]({ run_id = "run-review-routing" }).step_id == "review")
local stale_review = tools["project_pipelines.request_step_advance"]({ run_id = "run-review-routing" })
assert(not stale_review.ok and stale_review.error.code == "transition_blocked")
assert(stale_review.error.blockers[1].kind == "review_missing", "serviced review verdict must not control a later visit")
assert(tools["project_pipelines.submit_review"]({
  run_id = "run-review-routing", step_id = "review", verdict = "approved",
}).ok)
local approved_route = tools["project_pipelines.request_step_advance"]({ run_id = "run-review-routing" })
assert(approved_route.ok and approved_route.step_id == "verify", "approved review must route forward")
local review_route_context = tools["project_pipelines.current_context"]({ run_id = "run-review-routing" })
assert(#review_route_context.run_steps == 5, "each review route must create a durable run-step visit")

local entities = tools["project_pipelines.entities"]({})
assert(entities.ok and #entities.frames >= 5)
local handlers = {}
local entity_providers = {}
for _, handler in ipairs(plugin.handlers) do
  handlers[handler.descriptor_id] = handler.call
  if handler.kind == "entity_provider" then
    assert(handler.descriptor.entity_type == handler.descriptor_id)
    assert(handler.descriptor.id_field == "id")
    entity_providers[handler.descriptor_id] = handler.call
  end
end
local expected_entity_families = {
  "project", "project_target", "ticket", "ticket_dependency",
  "pipeline_definition", "run", "run_step", "gate_result", "review",
  "finding", "artifact", "checklist", "checklist_item", "question",
  "answer", "question_orchestrator", "pr_link", "event", "session_request",
}
local provider_count = 0
for _ in pairs(entity_providers) do provider_count = provider_count + 1 end
assert(provider_count == #expected_entity_families, "entity provider set must be closed")
for _, family in ipairs(expected_entity_families) do
  local entity_type = "project-pipelines." .. family
  local provider = entity_providers[entity_type]
  assert(provider, "missing entity provider " .. entity_type)
  local first_snapshot = provider({ entity_type = entity_type })
  local reconnect_snapshot = provider({ entity_type = entity_type })
  assert(first_snapshot.type == "entity_snapshot" and first_snapshot.entity_type == entity_type)
  assert(reconnect_snapshot.snapshot_seq == first_snapshot.snapshot_seq + 1, "reconnect snapshot must be fresh")
end
local run_snapshot = entity_providers["project-pipelines.run"]({ entity_type = "project-pipelines.run" })
assert(#run_snapshot.items == #tools["project_pipelines.current_context"]({}).runs, "run snapshot must match committed context")
local merged = handlers["pr_merged"]({ repo = "example/repo", pr_number = 1, merge_commit = "abc123" })
assert(merged.ok and merged.ticket.status == "closed" and merged.run.status == "closed")
local home = handlers["project-pipelines.home"]({})
assert(home.id == "project-pipelines-home")
local function find_node(node, id)
  if type(node) ~= "table" then return nil end
  if node.id == id then return node end
  if type(node.node) == "table" then
    local found = find_node(node.node, id)
    if found then return found end
  end
  for _, child in ipairs(node.children or {}) do
    local found = find_node(child, id)
    if found then return found end
  end
  for _, children in pairs(node.slots or {}) do
    for _, child in ipairs(children) do
      local found = find_node(child, id)
      if found then return found end
    end
  end
  return nil
end
assert(find_node(home, "project-pipelines-workbench-toolbar").type == "toolbar")
assert(find_node(home, "project-pipelines-project-table").type == "table")
local settings = handlers["project-pipelines.settings"]({})
assert(find_node(settings, "project-pipelines-provider-dependency-status"), "settings must expose provider diagnostics")

durable_store["v3/tickets/malformed"] = {
  key = "v3/tickets/malformed", schema_version = 3, revision = 1,
  payload = { id = "malformed" },
}
local malformed_ok = pcall(tools["project_pipelines.current_context"], {})
assert(not malformed_ok, "malformed durable record must fail closed")
durable_store["v3/tickets/malformed"] = nil

durable_store["v2/tickets/legacy"] = {
  key = "v2/tickets/legacy", schema_version = 2, revision = 1,
  payload = { id = "legacy", project_id = "project-one", title = "Legacy", status = "open" },
}
local cleaned = dofile("plugin.lua")
assert(cleaned and durable_store["v2/tickets/legacy"] == nil, "v2 namespace must be removed atomically on load")

local source_key = "v3/pipeline_definitions/botster_stack_delivery"
assert(durable_store[source_key], "sourced delivery definition missing")
durable_store[source_key].payload.steps[1].agent_name = "operator-selected"
durable_store[source_key].payload.source_revision = "stale"
local reloaded = dofile("plugin.lua")
local reloaded_tools = {}
for _, descriptor in ipairs(reloaded.tools) do reloaded_tools[descriptor.name] = descriptor.call end
local sourced
for _, pipeline in ipairs(reloaded_tools["project_pipelines.list_pipelines"]({}).pipelines) do
  if pipeline.id == "botster_stack_delivery" then sourced = pipeline end
end
assert(sourced and sourced.steps[1].agent_name == "operator-selected")
local sourced_review
for _, step in ipairs(sourced.steps) do if step.id == "botster_stack_review" then sourced_review = step end end
assert(sourced_review.on_approved_step_id == "botster_stack_verify")
assert(sourced_review.on_changes_requested_step_id == "botster_stack_implement")
assert(sourced_review.on_blocked_step_id == "botster_stack_implement")
local routed = false
for _, step in ipairs(sourced.steps) do
  if step.prompt and step.prompt:find("botster%-workspaces%-playbook") then routed = true end
end
assert(routed, "Botster Stack Delivery must retain botster-workspaces routing")

print("project-pipelines authoritative package checks passed")
