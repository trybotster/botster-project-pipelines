fail_batch_key_prefix = "v3/run_steps/"
local failed = tools["project_pipelines.start_run"]({
  id = "run-atomic", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(not failed.ok and failed.error.code == "persist_failed")
local after_failure = tools["project_pipelines.current_context"]({})
local failed_ticket
for _, ticket in ipairs(after_failure.tickets) do if ticket.id == "ticket-blocked" then failed_ticket = ticket end end
assert(failed_ticket.status == "open", "failed atomic start must not activate ticket")
for _, run in ipairs(after_failure.runs) do assert(run.id ~= "run-atomic", "failed atomic start must not create run") end

fail_batch_key_prefix = nil
local started = tools["project_pipelines.start_run"]({
  id = "run-atomic", ticket_id = "ticket-blocked", pipeline_id = "pipeline-two-step",
})
assert(started.ok and started.ticket.status == "active")
assert(started.run.current_run_step_id == started.run_step.id)
assert(#tools["project_pipelines.get_ticket"]({ ticket_id = "ticket-blocked" }).runs == 1)
fail_batch_key_prefix = "v3/run_steps/"
local failed_child = tools["project_pipelines.create_child_run"]({
  id = "run-child", ticket_id = "ticket-child", parent_run_id = "run-atomic", title = "Child",
})
assert(not failed_child.ok and failed_child.error.code == "persist_failed")
local after_failed_child = tools["project_pipelines.current_context"]({})
for _, ticket in ipairs(after_failed_child.tickets) do assert(ticket.id ~= "ticket-child", "failed atomic child creation must not create ticket") end
for _, run in ipairs(after_failed_child.runs) do assert(run.id ~= "run-child", "failed atomic child creation must not create run") end
fail_batch_key_prefix = nil
local child = tools["project_pipelines.create_child_run"]({
  id = "run-child", ticket_id = "ticket-child", parent_run_id = "run-atomic", title = "Child",
})
assert(child.ok and child.ticket.id == "ticket-child" and child.run.ticket_id == "ticket-child")
