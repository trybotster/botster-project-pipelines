-- Terminal runs and closed owning tickets must never be resurrected by later dependency
-- clearance: the waiting transition is cleared at the terminal mutation and reconciliation
-- refuses anything that is not still explicitly resumable.
local function assert_not_resurrected(scenario, expected_run_status)
  local context = context_for(scenario.run_id)
  assert(context.run.status == expected_run_status)
  assert(context.run.waiting_transition == nil, "terminal state must clear the waiting transition")
  assert(context.run.current_step_id == "waiting-plan-review")
  assert(context.run.current_run_step_id == scenario.run_step_id)
  assert(#context.run_steps == 1, "terminal run must not gain a target run-step")
  assert(#spawned == scenario.spawned_before)
end

local cancelled_scenario = create_waiting_scenario("waiting-cancelled", 1)
assert(tools["project_pipelines.cancel_run"]({ run_id = cancelled_scenario.run_id, reason = "operator stopped" }).ok)
assert_not_resurrected(cancelled_scenario, "cancelled")
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = cancelled_scenario.dependency_ids[1], status = "closed",
}).ok)
assert_not_resurrected(cancelled_scenario, "cancelled")

local closed_owner_scenario = create_waiting_scenario("waiting-closed-owner", 1)
assert(tools["project_pipelines.close_ticket"]({
  ticket_id = closed_owner_scenario.ticket_id, merge_confirmed = true,
}).ok)
assert_not_resurrected(closed_owner_scenario, "closed")
assert(tools["project_pipelines.close_ticket"]({ ticket_id = closed_owner_scenario.dependency_ids[1] }).ok)
assert_not_resurrected(closed_owner_scenario, "closed")

-- Adding a blocker to an already-waiting run can only add blockers, so its reconcile is a
-- snapshot refresh; assert that refresh rather than leaving the call site unexercised.
local snapshot_scenario = create_waiting_scenario("waiting-snapshot", 1)
assert(tools["project_pipelines.create_ticket"]({
  id = "waiting-snapshot-extra", project_id = "project-one", title = "Extra blocker",
}).ok)
assert(tools["project_pipelines.add_ticket_dependency"]({
  ticket_id = snapshot_scenario.ticket_id, dependency_ticket_id = "waiting-snapshot-extra",
}).ok)
local snapshot_context = context_for(snapshot_scenario.run_id)
assert(#snapshot_context.run.waiting_transition.unmet_dependencies == 2,
  "adding a blocker to a waiting run must refresh its dependency snapshot")
assert(#snapshot_context.run_steps == 1 and #spawned == snapshot_scenario.spawned_before)

-- A merged provider PR is delivered through the exact package event
-- project-pipelines/pr_merged. The public producer is link_pr(status=merged).
local pr_merged_handler
local pr_merged_registration
for _, handler in ipairs(plugin.handlers) do
  if handler.id == "pr_merged" then
    pr_merged_handler = handler.call
    pr_merged_registration = handler
  end
end
assert(pr_merged_handler, "pr_merged event handler must be registered")
assert(pr_merged_registration.kind == "event", "pr_merged must stay an event handler")
assert(pr_merged_registration.event_owner == "project-pipelines", "pr_merged must subscribe to this package")
assert(pr_merged_registration.event == "pr_merged")
local merged_scenario = create_waiting_scenario("waiting-merged", 1)
-- A merge closes its own ticket, so a different run blocked on that ticket must wake in
-- the same atomic save. This is what the handler's reconcile call exists for.
assert(tools["project_pipelines.create_ticket"]({
  id = "waiting-merge-dependent-ticket", project_id = "project-one", target_id = "target-one",
  title = "Blocked on the merged ticket",
}).ok)
local merge_dependent_started = tools["project_pipelines.start_run"]({
  id = "waiting-merge-dependent-run", ticket_id = "waiting-merge-dependent-ticket",
  pipeline_id = "pipeline-waiting-wakeup",
})
assert(merge_dependent_started.ok)
assert(tools["project_pipelines.add_ticket_dependency"]({
  ticket_id = "waiting-merge-dependent-ticket", dependency_ticket_id = merged_scenario.ticket_id,
}).ok)
assert(tools["project_pipelines.submit_review"]({
  run_id = "waiting-merge-dependent-run", run_step_id = merge_dependent_started.run_step.id,
  step_id = "waiting-plan-review", verdict = "approved",
}).ok)
local merge_dependent_wait = tools["project_pipelines.request_step_advance"]({
  run_id = "waiting-merge-dependent-run", request_id = "waiting-merge-dependent-advance",
})
assert(not merge_dependent_wait.ok and merge_dependent_wait.error.code == "ticket_dependencies_unmet")
assert(tools["project_pipelines.link_pr"]({
  run_id = merged_scenario.run_id, url = "https://example.invalid/pull/1",
}).ok)
emit_stub.events = {}
assert(tools["project_pipelines.link_pr"]({
  run_id = merged_scenario.run_id,
  url = "https://example.invalid/pull/1",
  status = "merged",
  merge_commit = "deadbeef",
}).ok)
assert(#emit_stub.events == 1 and emit_stub.events[1].name == "pr_merged")
assert(emit_stub.events[1].payload.run_id == merged_scenario.run_id)
assert(emit_stub.events[1].payload.pr_url == "https://example.invalid/pull/1")
assert(pr_merged_handler(emit_stub.events[1].payload).ok)
local merge_dependent_context = context_for("waiting-merge-dependent-run")
assert(merge_dependent_context.run.current_step_id == "waiting-implement",
  "a merge that closes a blocking ticket must wake the run waiting on it")
assert(merge_dependent_context.run.waiting_transition == nil)
assert(#merge_dependent_context.run_steps == 2)
local merged_context = context_for(merged_scenario.run_id)
assert(merged_context.run.status == "closed")
assert(merged_context.run.waiting_transition == nil, "a merged provider PR must clear durable waiting state")
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = merged_scenario.dependency_ids[1], status = "closed",
}).ok)
local after_merge_clearance = context_for(merged_scenario.run_id)
assert(after_merge_clearance.run.status == "closed")
assert(after_merge_clearance.run.current_step_id == "waiting-plan-review")
assert(#after_merge_clearance.run_steps == 1, "clearing the blocker must not resurrect a merged run")
assert(#spawned == merged_scenario.spawned_before)

local updated_owner_scenario = create_waiting_scenario("waiting-updated-owner", 1)
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = updated_owner_scenario.ticket_id, status = "closed",
}).ok)
assert(context_for(updated_owner_scenario.run_id).run.waiting_transition == nil,
  "closing the owning ticket must clear its waiting transition")
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = updated_owner_scenario.dependency_ids[1], status = "closed",
}).ok)
assert_not_resurrected(updated_owner_scenario, "active")

-- Dependency clearance must revalidate the source visit against current review, gate, and
-- finding authorization rather than replaying the authorization captured at request time.
assert(tools["project_pipelines.create_pipeline"]({
  id = "pipeline-waiting-authorization", name = "Waiting authorization",
  steps = {
    {
      id = "authorization-review", name = "Authorization review", allows_open_ticket_dependencies = true,
      on_approved_step_id = "authorization-implement",
      on_changes_requested_step_id = "authorization-rework",
      gates = { { id = "authorization-gate", prompt = "Prove authorization before advancing" } },
    },
    { id = "authorization-implement", name = "Implement", kind = "pty", session_type_id = "codex-session-type" },
    { id = "authorization-rework", name = "Rework" },
  },
}).ok)

local function create_authorization_scenario(prefix, waive_unmet_gate)
  assert(tools["project_pipelines.create_ticket"]({
    id = prefix .. "-ticket", project_id = "project-one", target_id = "target-one", title = prefix .. " ticket",
  }).ok)
  local started = tools["project_pipelines.start_run"]({
    id = prefix .. "-run", ticket_id = prefix .. "-ticket", pipeline_id = "pipeline-waiting-authorization",
  })
  assert(started.ok)
  assert(tools["project_pipelines.create_ticket"]({
    id = prefix .. "-dependency", project_id = "project-one", title = prefix .. " dependency",
  }).ok)
  assert(tools["project_pipelines.add_ticket_dependency"]({
    ticket_id = prefix .. "-ticket", dependency_ticket_id = prefix .. "-dependency",
  }).ok)
  if not waive_unmet_gate then
    assert(tools["project_pipelines.submit_gate"]({
      run_id = prefix .. "-run", run_step_id = started.run_step.id, step_id = "authorization-review",
      gate_id = "authorization-gate", status = "passed",
    }).ok)
  end
  assert(tools["project_pipelines.submit_review"]({
    run_id = prefix .. "-run", run_step_id = started.run_step.id,
    step_id = "authorization-review", verdict = "approved",
  }).ok)
  local spawned_before = #spawned
  -- Always correlate: a dependency-blocked advance persists a pending advance_request, so
  -- the correlated retry path is ordinary operation rather than a crash-only path.
  local advance_arguments = { run_id = prefix .. "-run", request_id = prefix .. "-advance" }
  if waive_unmet_gate then
    advance_arguments.override_unmet_gates = true
    advance_arguments.override_reason = "gate waived while dependency-blocked"
  end
  local waiting = tools["project_pipelines.request_step_advance"](advance_arguments)
  assert(not waiting.ok and waiting.error.code == "ticket_dependencies_unmet")
  return {
    run_id = prefix .. "-run", ticket_id = prefix .. "-ticket",
    dependency_id = prefix .. "-dependency", run_step_id = started.run_step.id,
    request_id = prefix .. "-advance", spawned_before = spawned_before,
  }
end

local function assert_unauthorized_wait(scenario, blocker_kind)
  local context = context_for(scenario.run_id)
  assert(context.run.current_step_id == "authorization-review",
    "dependency clearance must not advance a source visit whose authorization changed")
  assert(context.run.current_run_step_id == scenario.run_step_id)
  assert(#context.run_steps == 1, "unauthorized wakeup must not create the target run-step")
  assert(#spawned == scenario.spawned_before)
  assert(context.run.waiting_transition.unauthorized == true)
  assert(context.run.waiting_transition.unmet_dependencies == nil,
    "a satisfied dependency snapshot must be absent, not an empty collection")
  assert(context.run.waiting_transition.unmet_authorization[1].kind == blocker_kind,
    "waiting must record the current authorization blocker " .. blocker_kind)
  assert(count_events(scenario.run_id, "ticket_dependencies_waiting_unauthorized") == 1)
end

-- Waiting state is retained rather than destroyed while unauthorized, so the mutation that
-- restores authorization must itself wake the run. Each scenario below leaves the
-- dependency already satisfied and makes exactly one authorization mutation afterwards,
-- with no dependency row added, removed, or changed and no explicit advance.
local function assert_reauthorized_once(scenario, dependency_rows_before)
  local context = context_for(scenario.run_id)
  assert(context.run.current_step_id == "authorization-implement",
    "restoring authorization must itself wake the retained waiting transition")
  assert(context.run.waiting_transition == nil)
  assert(#context.run_steps == 2, "restored authorization must create exactly one target run-step")
  local source_visits, target_visits = 0, 0
  for _, run_step in ipairs(context.run_steps) do
    if run_step.id == scenario.run_step_id then
      source_visits = source_visits + 1
      assert(run_step.status == "done")
    elseif run_step.step_id == "authorization-implement" then
      target_visits = target_visits + 1
      assert(run_step.status == "active")
    end
  end
  assert(source_visits == 1 and target_visits == 1)
  local rows = tools["project_pipelines.list_ticket_dependencies"]({ ticket_id = scenario.ticket_id }).dependencies
  assert(#rows == dependency_rows_before,
    "waking on restored authorization must not depend on changing a dependency row")
end

local stale_review_scenario = create_authorization_scenario("waiting-stale-review")
assert(tools["project_pipelines.submit_review"]({
  run_id = stale_review_scenario.run_id, run_step_id = stale_review_scenario.run_step_id,
  step_id = "authorization-review", verdict = "changes_required",
}).ok)
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = stale_review_scenario.dependency_id, status = "closed",
}).ok)
assert_unauthorized_wait(stale_review_scenario, "route_changed")
assert(tools["project_pipelines.submit_review"]({
  run_id = stale_review_scenario.run_id, run_step_id = stale_review_scenario.run_step_id,
  step_id = "authorization-review", verdict = "approved",
}).ok)
assert_reauthorized_once(stale_review_scenario, 1)

local failed_gate_scenario = create_authorization_scenario("waiting-failed-gate")
assert(tools["project_pipelines.submit_gate"]({
  run_id = failed_gate_scenario.run_id, run_step_id = failed_gate_scenario.run_step_id,
  step_id = "authorization-review", gate_id = "authorization-gate", status = "failed",
}).ok)
assert(tools["project_pipelines.close_ticket"]({ ticket_id = failed_gate_scenario.dependency_id }).ok)
assert_unauthorized_wait(failed_gate_scenario, "gate")
assert(tools["project_pipelines.submit_gate"]({
  run_id = failed_gate_scenario.run_id, run_step_id = failed_gate_scenario.run_step_id,
  step_id = "authorization-review", gate_id = "authorization-gate", status = "passed",
}).ok)
assert_reauthorized_once(failed_gate_scenario, 1)

local late_finding_scenario = create_authorization_scenario("waiting-late-finding")
assert(tools["project_pipelines.submit_review"]({
  run_id = late_finding_scenario.run_id, run_step_id = late_finding_scenario.run_step_id,
  step_id = "authorization-review", verdict = "approved",
  findings = { { id = "waiting-late-high", severity = "high", title = "Late high finding" } },
}).ok)
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = late_finding_scenario.dependency_id, status = "closed",
}).ok)
assert_unauthorized_wait(late_finding_scenario, "finding")
assert(tools["project_pipelines.resolve_finding"]({ finding_id = "waiting-late-high" }).ok)
assert_reauthorized_once(late_finding_scenario, 1)

-- Every dependency-blocked advance persists a pending advance_request, so retrying the
-- same request_id is an ordinary operation and must not become a back door around the
-- authorization revalidation the clearance path performs.
local retry_review_scenario = create_authorization_scenario("waiting-retry-review")
assert(tools["project_pipelines.submit_review"]({
  run_id = retry_review_scenario.run_id, run_step_id = retry_review_scenario.run_step_id,
  step_id = "authorization-review", verdict = "changes_required",
  findings = { { id = "waiting-retry-blocker", severity = "blocker", title = "Blocking rework" } },
}).ok)
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = retry_review_scenario.dependency_id, status = "closed",
}).ok)
assert_unauthorized_wait(retry_review_scenario, "route_changed")
local stale_review_retry = tools["project_pipelines.request_step_advance"]({
  run_id = retry_review_scenario.run_id, request_id = retry_review_scenario.request_id,
})
assert(not stale_review_retry.ok and stale_review_retry.error.code == "transition_authorization_changed",
  "a correlated retry must not apply a transition whose route was superseded by a newer verdict")
assert_unauthorized_wait(retry_review_scenario, "route_changed")

local retry_gate_scenario = create_authorization_scenario("waiting-retry-gate")
assert(tools["project_pipelines.submit_gate"]({
  run_id = retry_gate_scenario.run_id, run_step_id = retry_gate_scenario.run_step_id,
  step_id = "authorization-review", gate_id = "authorization-gate", status = "failed",
}).ok)
assert(tools["project_pipelines.close_ticket"]({ ticket_id = retry_gate_scenario.dependency_id }).ok)
assert_unauthorized_wait(retry_gate_scenario, "gate")
local failed_gate_retry = tools["project_pipelines.request_step_advance"]({
  run_id = retry_gate_scenario.run_id, request_id = retry_gate_scenario.request_id,
})
assert(not failed_gate_retry.ok and failed_gate_retry.error.code == "transition_authorization_changed",
  "a correlated retry must not apply a transition whose required gate now fails")
assert_unauthorized_wait(retry_gate_scenario, "gate")

-- A correlated retry rebuilt from the advance_request alone would drop the operator's
-- stored override; the durable waiting transition is the authority while parked.
local override_retry_scenario = create_authorization_scenario("waiting-override-retry", true)
assert(context_for(override_retry_scenario.run_id).run.waiting_transition.overridden_gate_ids[1] == "authorization-gate")
local override_retry = tools["project_pipelines.request_step_advance"]({
  run_id = override_retry_scenario.run_id, request_id = override_retry_scenario.request_id,
})
assert(not override_retry.ok and override_retry.error.code == "ticket_dependencies_unmet")
assert(context_for(override_retry_scenario.run_id).run.waiting_transition.overridden_gate_ids[1] == "authorization-gate",
  "a correlated retry while still dependency-blocked must preserve the stored gate override")
assert(count_events(override_retry_scenario.run_id, "gates_overridden") == 0)
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = override_retry_scenario.dependency_id, status = "closed",
}).ok)
assert_reauthorized_once(override_retry_scenario, 1)
assert(count_events(override_retry_scenario.run_id, "gates_overridden") == 1,
  "the preserved override must be audited exactly once when the transition is applied")

-- The operator attention queue keys on the durable hold record, not one code string. An
-- authorization-held run is precisely the one needing a human, so it must appear alongside
-- dependency-held runs and the rendered metric must equal the rendered list.
local home_surface
for _, handler in ipairs(plugin.handlers) do
  if handler.id == "home_surface" then home_surface = handler.call end
end
assert(home_surface, "home surface handler must be registered")
local function collect_nodes(node, seen)
  seen = seen or {}
  if type(node) ~= "table" then return seen end
  if node.id then seen[node.id] = node end
  for _, child in ipairs(node.children or {}) do collect_nodes(child, seen) end
  for _, slot in pairs(node.slots or {}) do
    if type(slot) == "table" then
      for _, child in ipairs(slot) do collect_nodes(child, seen) end
    end
  end
  return seen
end
local function attention_subtitle(nodes, run_id)
  local subtitle = nodes["project-pipelines-attention-dependencies-" .. run_id .. "-subtitle-text"]
  return subtitle and subtitle.props.text
end

local dependency_held_scenario = create_waiting_scenario("waiting-attention", 1)
local home_nodes = collect_nodes(home_surface())
local dependency_attention = attention_subtitle(home_nodes, dependency_held_scenario.run_id)
assert(dependency_attention and dependency_attention:find("waiting-attention-dependency-1", 1, true),
  "a dependency-held run must stay in the attention queue and name its blocking ticket")
local route_attention = attention_subtitle(home_nodes, retry_review_scenario.run_id)
assert(route_attention and route_attention:find("route_changed", 1, true),
  "an authorization-held run must stay in the attention queue and name its authorization blocker")
local gate_attention = attention_subtitle(home_nodes, retry_gate_scenario.run_id)
assert(gate_attention and gate_attention:find("gate authorization-gate", 1, true),
  "a gate-held run must name the gate that now blocks it")
local attention_list = home_nodes["project-pipelines-needs-attention-list"]
assert(attention_list, "the needs-attention list must render")
assert(home_nodes["project-pipelines-metric-attention"].props.value == tostring(#attention_list.children),
  "the needs-attention metric must equal the number of rendered attention rows")
local held_run_row
for _, row in ipairs(home_nodes["project-pipelines-run-table"].props.rows or {}) do
  if row.id == retry_gate_scenario.run_id then held_run_row = row end
end
assert(held_run_row and held_run_row.cells.blocker:find("gate authorization-gate", 1, true),
  "the runs table blocker cell must name an authorization hold instead of rendering empty")

-- A gate override on a dependency-blocked advance waives gates only. Nothing advanced, so
-- the audit event must not be committed until the stored override is actually applied.
local blocked_override_scenario = create_authorization_scenario("waiting-blocked-override", true)
assert(count_events(blocked_override_scenario.run_id, "gates_overridden") == 0,
  "a dependency-blocked override must not commit a gates_overridden audit event")
assert(tools["project_pipelines.update_ticket"]({
  ticket_id = blocked_override_scenario.dependency_id, status = "closed",
}).ok)
local applied_override = context_for(blocked_override_scenario.run_id)
assert(applied_override.run.current_step_id == "authorization-implement")
assert(applied_override.run.waiting_transition == nil)
assert(#applied_override.run_steps == 2, "the stored override must still create exactly one target run-step")
assert(count_events(blocked_override_scenario.run_id, "gates_overridden") == 1,
  "the stored override must be audited exactly once, when the transition is applied")
for _, event in ipairs(applied_override.events) do
  if event.kind == "gates_overridden" then
    assert(event.payload.gate_ids[1] == "authorization-gate")
    assert(event.payload.reason == "gate waived while dependency-blocked")
  end
end

