#!/usr/bin/env ruby
# frozen_string_literal: true

require "timeout"
require "tmpdir"
require "fileutils"
require "json"
require "socket"
require "open3"

ROOT = File.expand_path("..", __dir__)
# This pin is the merged Hub revision for the contract proven by this package.
# README.md documents when and how to advance it.
EXPECTED_HUB_COMMIT = "12e0cc6994be18024e4bdfffb22947526a652204"

def required_executable(name)
  path = File.expand_path(ENV.fetch(name) { raise "#{name} must point at an executable" }, ROOT)
  raise "#{name} is not executable: #{path}" unless File.executable?(path)

  path
end

def run!(*command, **options)
  raise "command failed: #{command.join(" ")}" unless system(*command, **options)
end

def encode_plugin_store_key(key)
  key.bytes.map { |byte| format("%02x", byte) }.join
end

def open_hub_socket(socket_path)
  socket = UNIXSocket.new(socket_path)
  socket.puts(JSON.generate({
    protocol: "botster-hub-daemon-v1",
    compatibility: {
      protocol: "botster-hub-daemon-v1",
      protocol_version: 6,
      required_features: [],
      minimum_conformance_fixture_revision: 1,
      client_name: "project-pipelines-question-opened-harness"
    }
  }))
  JSON.parse(socket.gets || raise("daemon closed before hello"))
  socket
end

def call_hub_tool(socket, name, arguments)
  socket.puts(JSON.generate({ type: "plugin_mcp_call_tool", name: name, arguments: arguments }))
  response = JSON.parse(socket.gets || raise("daemon closed during #{name}"))
  raise "#{name} daemon error: #{response["error"]}" if response["error"]
  response.fetch("plugin_tool_result")
end

def subscribe_entity_snapshot(socket_path, entity_type, subscription_id)
  last_error = nil
  8.times do |attempt|
    subscription = UNIXSocket.new(socket_path)
    begin
      subscription.puts(JSON.generate({
        protocol: "botster-hub-daemon-v1",
        compatibility: {
          protocol: "botster-hub-daemon-v1",
          protocol_version: 6,
          required_features: ["plugin_entity_subscriptions"],
          minimum_conformance_fixture_revision: 1,
          client_name: "project-pipelines-question-opened-entity"
        }
      }))
      JSON.parse(subscription.gets || raise("daemon closed before entity hello"))
      attempt_id = "#{subscription_id}-#{attempt}"
      subscription.puts(JSON.generate({
        type: "subscribe_entities",
        entity_type: entity_type,
        subscription_id: attempt_id
      }))
      accepted = JSON.parse(subscription.gets || raise("daemon closed before entity subscription response"))
      unless accepted["kind"] == "entity_subscribed"
        last_error = accepted
        sleep 1
        next
      end
      frame = Timeout.timeout(5) do
        JSON.parse(subscription.gets || raise("daemon closed before #{entity_type} snapshot"))
      end
      raise "#{entity_type} did not return an authoritative snapshot: #{frame.inspect}" unless frame["type"] == "entity_snapshot"
      return frame
    rescue StandardError => error
      last_error = error
      sleep 1
    ensure
      subscription.close
    end
  end
  raise "#{entity_type} subscription failed: #{last_error.inspect}"
end

def open_held_entity_subscription(socket_path, entity_type, subscription_id)
  last_error = nil
  8.times do |attempt|
    subscription = UNIXSocket.new(socket_path)
    begin
      subscription.puts(JSON.generate({
        protocol: "botster-hub-daemon-v1",
        compatibility: {
          protocol: "botster-hub-daemon-v1",
          protocol_version: 6,
          required_features: ["plugin_entity_subscriptions"],
          minimum_conformance_fixture_revision: 1,
          client_name: "project-pipelines-held-entity"
        }
      }))
      JSON.parse(subscription.gets || raise("daemon closed before held entity hello"))
      attempt_id = "#{subscription_id}-#{attempt}"
      subscription.puts(JSON.generate({
        type: "subscribe_entities",
        entity_type: entity_type,
        subscription_id: attempt_id
      }))
      accepted = JSON.parse(subscription.gets || raise("daemon closed before held entity subscription response"))
      unless accepted["kind"] == "entity_subscribed"
        last_error = accepted
        subscription.close
        sleep 1
        next
      end
      snapshot = Timeout.timeout(5) do
        JSON.parse(subscription.gets || raise("daemon closed before #{entity_type} held snapshot"))
      end
      unless snapshot["type"] == "entity_snapshot"
        last_error = snapshot
        subscription.close
        sleep 1
        next
      end
      return [subscription, snapshot]
    rescue StandardError => error
      last_error = error
      subscription.close
      sleep 1
    end
  end
  raise "#{entity_type} held subscription failed: #{last_error.inspect}"
end

def wait_entity_frame(subscription, timeout: 8)
  Timeout.timeout(timeout) do
    JSON.parse(subscription.gets || raise("held entity subscription closed"))
  end
end

def wait_entity_upsert(subscription, entity_type, id, timeout: 8)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise "#{entity_type} #{id} upsert did not arrive" if remaining <= 0
    frame = wait_entity_frame(subscription, timeout: remaining)
    next unless frame["type"] == "entity_upsert"
    next unless frame["entity_type"] == entity_type || frame["family"] == entity_type
    next unless frame["id"] == id
    return frame
  end
end

def open_event_socket(socket_path, client_name)
  socket = UNIXSocket.new(socket_path)
  socket.puts(JSON.generate({
    protocol: "botster-hub-daemon-v1",
    compatibility: {
      protocol: "botster-hub-daemon-v1",
      protocol_version: 6,
      required_features: ["package_event_subscriptions"],
      minimum_conformance_fixture_revision: 1,
      client_name: client_name
    }
  }))
  JSON.parse(socket.gets || raise("daemon closed before event hello"))
  socket
end

def subscribe_package_event(socket, subscription_id, owner, name, subjects)
  socket.puts(JSON.generate({
    type: "subscribe_events",
    subscription_id: subscription_id,
    owner: owner,
    name: name,
    subjects: subjects
  }))
  accepted = JSON.parse(socket.gets || raise("daemon closed before event subscription"))
  raise "event subscribe failed: #{accepted.inspect}" unless accepted["kind"] == "event_subscribed"
  accepted
end

def wait_package_event(socket, timeout:)
  Timeout.timeout(timeout) do
    loop do
      frame = JSON.parse(socket.gets || raise("event socket closed"))
      return frame if frame["type"] == "package_event"
    end
  end
end

def assert_no_package_event(socket, timeout:, label:)
  readable, = IO.select([socket], nil, nil, timeout)
  return unless readable
  frame = JSON.parse(socket.gets || raise("#{label} closed during negative wait"))
  raise "#{label} received #{frame.inspect}"
end

def resolve_notice_text(payload, pointer)
  raise "notice pointer must be one top-level pointer: #{pointer.inspect}" unless pointer.match?(%r{\A/[^/]+\z})
  property = pointer[1..]
  text = payload[property]
  raise "notice text missing at #{pointer}: #{payload.inspect}" unless text.is_a?(String) && !text.empty?
  text
end

class ObservationError < RuntimeError; end

def daemon_request(socket_path, payload)
  socket = open_hub_socket(socket_path)
  begin
    socket.puts(JSON.generate(payload))
    JSON.parse(socket.gets || raise("daemon closed during #{payload[:type] || payload["type"]}"))
  ensure
    socket.close
  end
end

def sessions_from_daemon_response(response)
  if response["error"]
    raise ObservationError, "list_sessions error: #{response["error"].inspect}"
  end
  unless response["kind"] == "sessions"
    raise ObservationError, "list_sessions kind mismatch: #{response.inspect}"
  end
  sessions = response["sessions"]
  unless sessions.is_a?(Array)
    raise ObservationError, "list_sessions missing sessions array: #{response.inspect}"
  end
  sessions
end

def list_hub_sessions(socket_path)
  sessions_from_daemon_response(daemon_request(socket_path, { type: "list_sessions" }))
end

def session_row_matches?(row, session_id)
  [row["id"], row["session_id"], row["session_uuid"]].include?(session_id)
end

def logical_session_present?(socket_path, session_id)
  list_hub_sessions(socket_path).any? { |row| session_row_matches?(row, session_id) }
end

def process_liveness_from_signal_error(error)
  case error
  when Errno::ESRCH
    false
  when Errno::EPERM
    true
  else
    raise ObservationError, "process liveness observation failed: #{error.class}: #{error.message}"
  end
end

def process_alive?(pid)
  unless pid.is_a?(Integer) && pid.positive?
    raise ObservationError, "process liveness requires a positive pid: #{pid.inspect}"
  end

  Process.kill(0, pid)
  true
rescue Errno::ESRCH, Errno::EPERM => error
  process_liveness_from_signal_error(error)
end

def capture_command(*args)
  Open3.capture3(*args)
end

def parent_pid(pid, capture: method(:capture_command))
  stdout, stderr, status = capture.call("ps", "-o", "ppid=", "-p", pid.to_s)
  unless status.success?
    raise ObservationError, "ps parent lookup failed pid=#{pid} status=#{status.exitstatus} stderr=#{stderr}"
  end
  value = stdout.strip.to_i
  unless value.positive?
    raise ObservationError, "ps parent lookup returned no pid pid=#{pid} stdout=#{stdout.inspect}"
  end
  value
end

def child_pids(pid, capture: method(:capture_command))
  stdout, stderr, status = capture.call("pgrep", "-P", pid.to_s)
  return [] if status.exitstatus == 1 && stdout.strip.empty?
  unless status.success?
    raise ObservationError, "pgrep children lookup failed pid=#{pid} status=#{status.exitstatus} stderr=#{stderr}"
  end
  stdout.split.map(&:to_i)
end

def process_command(pid, capture: method(:capture_command))
  stdout, stderr, status = capture.call("ps", "-p", pid.to_s, "-o", "command=")
  unless status.success?
    raise ObservationError, "ps command lookup failed pid=#{pid} status=#{status.exitstatus} stderr=#{stderr}"
  end
  command = stdout.strip
  if command.empty?
    raise ObservationError, "ps command lookup returned empty pid=#{pid} stdout=#{stdout.inspect}"
  end
  command
end

def session_worker_command?(command)
  argv0 = command.split.first.to_s
  File.basename(argv0) == "botster-session-worker"
end

def session_worker_ancestor(pid, capture: method(:capture_command))
  current = pid
  8.times do
    unless current.positive?
      raise ObservationError, "held session worker identity is missing for command pid #{pid}"
    end
    command = process_command(current, capture: capture)
    return current if session_worker_command?(command)
    parent = parent_pid(current, capture: capture)
    if parent <= 1
      raise ObservationError, "held session worker identity is missing for command pid #{pid}"
    end
    current = parent
  end
  raise ObservationError, "held session worker identity is missing for command pid #{pid}"
end

def assert_raises_observation(label)
  begin
    yield
  rescue ObservationError
    return
  end
  raise "#{label} did not fail closed"
end

def assert_observation_errors_fail_closed
  assert_raises_observation("list_sessions error frame") do
    sessions_from_daemon_response({ "error" => { "code" => "boom" }, "sessions" => [] })
  end
  assert_raises_observation("list_sessions kind mismatch") do
    sessions_from_daemon_response({ "kind" => "status" })
  end
  assert_raises_observation("list_sessions missing sessions array") do
    sessions_from_daemon_response({ "kind" => "sessions" })
  end
  empty = sessions_from_daemon_response({ "kind" => "sessions", "sessions" => [] })
  raise "empty sessions array must remain a valid absence result" unless empty == []

  raise "EPERM must count as alive" unless process_liveness_from_signal_error(Errno::EPERM.new)
  raise "ESRCH must count as absent" if process_liveness_from_signal_error(Errno::ESRCH.new)
  assert_raises_observation("unknown kill error") do
    process_liveness_from_signal_error(RuntimeError.new("kill failed"))
  end
  assert_raises_observation("non-positive pid") { process_alive?(0) }

  failed = Open3.capture3("sh", "-c", "exit 2")[2]
  none = Open3.capture3("sh", "-c", "exit 1")[2]
  success = Open3.capture3("true")[2]
  assert_raises_observation("ps failure") do
    parent_pid(1, capture: ->(*) { ["", "ps: failed", failed] })
  end
  assert_raises_observation("ps empty parent") do
    parent_pid(1, capture: ->(*) { ["", "", success] })
  end
  assert_raises_observation("pgrep command failure") do
    child_pids(1, capture: ->(*) { ["", "pgrep: failed", failed] })
  end
  none_children = child_pids(1, capture: ->(*) { ["", "", none] })
  raise "pgrep status 1 must mean no children" unless none_children == []
  assert_raises_observation("ps command lookup failure") do
    process_command(1, capture: ->(*) { ["", "ps: failed", failed] })
  end
  assert_raises_observation("ps empty command") do
    process_command(1, capture: ->(*) { ["", "", success] })
  end

  cleanup = HeldSessionCleanup.new(hub: "hub", data_dir: "data", socket_path: "sock", session_id: "sess")
  assert_raises_observation("missing worktree") { cleanup.observe_descendants! }
  Dir.mktmpdir("bpp-obs-") do |dir|
    cleanup.worktree = dir
    assert_raises_observation("missing ready file") { cleanup.observe_descendants! }
    File.write(File.join(dir, "notice-subject-ready.json"), JSON.generate({ ready: true, pid: 0 }))
    assert_raises_observation("missing hold pid") { cleanup.observe_descendants! }

    dummy = spawn("sleep", "30")
    begin
      File.write(File.join(dir, "notice-subject-ready.json"), JSON.generate({ ready: true, pid: dummy }))
      injected = lambda do |*args|
        if args == ["ps", "-p", dummy.to_s, "-o", "command="]
          ["sleep 30", "", success]
        elsif args == ["ps", "-o", "ppid=", "-p", dummy.to_s]
          ["1", "", success]
        elsif args == ["pgrep", "-P", dummy.to_s]
          ["", "", none]
        else
          raise "unexpected observation capture #{args.inspect}"
        end
      end
      assert_raises_observation("missing worker identity") do
        cleanup.observe_descendants!(capture: injected)
      end
      assert_raises_observation("ps command lookup during observe") do
        cleanup.observe_descendants!(capture: ->(*) { ["", "ps: failed", failed] })
      end
    ensure
      begin
        Process.kill("TERM", dummy)
      rescue Errno::ESRCH
        nil
      end
      begin
        Process.wait(dummy)
      rescue Errno::ECHILD
        nil
      end
    end
  end
end

class HeldSessionCleanup
  attr_accessor :worktree
  attr_reader :session_id, :armed, :descendant_pids

  def initialize(hub:, data_dir:, socket_path:, session_id:)
    @hub = hub
    @data_dir = data_dir
    @socket_path = socket_path
    @session_id = session_id
    @worktree = nil
    @descendant_pids = []
    @armed = true
  end

  def observe_descendants!(capture: method(:capture_command))
    unless @worktree
      raise ObservationError, "held session worktree is missing"
    end

    ready_path = File.join(@worktree, "notice-subject-ready.json")
    unless File.file?(ready_path)
      raise ObservationError, "held session ready file is missing: #{ready_path}"
    end

    ready = JSON.parse(File.read(ready_path))
    hold_pid = ready["pid"].to_i
    unless hold_pid.positive?
      raise ObservationError, "held session ready file has no pid: #{ready.inspect}"
    end
    unless process_alive?(hold_pid)
      raise ObservationError, "held session command pid is not alive: #{hold_pid}"
    end

    worker_pid = session_worker_ancestor(hold_pid, capture: capture)
    unless process_alive?(worker_pid)
      raise ObservationError, "held session worker pid is not alive: #{worker_pid}"
    end

    pids = [hold_pid, worker_pid]
    pids.concat(child_pids(hold_pid, capture: capture))
    pids.concat(child_pids(worker_pid, capture: capture))
    @descendant_pids = pids.uniq.select { |pid| process_alive?(pid) }
    unless @descendant_pids.include?(hold_pid) && @descendant_pids.include?(worker_pid)
      raise ObservationError, "held session identities were not live after capture hold=#{hold_pid} worker=#{worker_pid} pids=#{@descendant_pids.inspect}"
    end
    @descendant_pids
  end

  def shutdown_and_wait!
    return unless @armed
    return if @session_id.to_s.empty?

    write_release_file
    shutdown_session
    remove_session_when_terminal
    wait_until_absent
    wait_until_descendants_absent
  end

  def disarm
    @armed = false
  end

  private

  def write_release_file
    return unless @worktree

    File.write(File.join(@worktree, "release-notice-subject"), "release\n")
  rescue StandardError
    nil
  end

  def shutdown_session
    system(
      @hub, "sessions", "shutdown", "--data-dir", @data_dir, @session_id,
      out: File::NULL, err: File::NULL
    )
  end

  def remove_session_when_terminal
    Timeout.timeout(8) do
      loop do
        return unless logical_session_present?(@socket_path, @session_id)

        response = daemon_request(@socket_path, { type: "remove_session", session_id: @session_id })
        return if response["kind"] == "session_removed"
        code = response.dig("error", "code")
        if code == "session_not_terminal"
          sleep 0.05
          next
        end
        return unless logical_session_present?(@socket_path, @session_id)

        raise "remove_session failed for #{@session_id}: #{response.inspect}"
      end
    end
  rescue Timeout::Error
    listed = list_hub_sessions(@socket_path).select { |row| session_row_matches?(row, @session_id) }
    raise "session #{@session_id} did not become removable: #{listed.inspect}"
  end

  def wait_until_absent
    Timeout.timeout(8) do
      sleep 0.05 while logical_session_present?(@socket_path, @session_id)
    end
  rescue Timeout::Error
    listed = list_hub_sessions(@socket_path).map { |row| row["session_id"] || row["id"] }
    raise "logical session #{@session_id} remained after production shutdown: #{listed.inspect}"
  end

  def wait_until_descendants_absent
    Timeout.timeout(8) do
      sleep 0.05 while @descendant_pids.any? { |pid| process_alive?(pid) }
    end
  rescue Timeout::Error
    survivors = @descendant_pids.select { |pid| process_alive?(pid) }
    raise "held session descendants remained after production shutdown: #{survivors.inspect}"
  end
end

assert_observation_errors_fail_closed

def write_notice_subject_hold_fixture(root)
  FileUtils.mkdir_p(File.join(root, "bin"))
  File.write(File.join(root, "plugin.lua"), "return botster.register({})\n")
  hold_script = File.join(root, "bin", "hold.rb")
  File.write(hold_script, <<~'RUBY')
    #!/usr/bin/env ruby
    # frozen_string_literal: true

    require "json"
    require "timeout"

    File.write("notice-subject-ready.json", JSON.generate({
      ready: true,
      session_id: ENV.fetch("BOTSTER_SESSION_ID"),
      pid: Process.pid
    }))
    Timeout.timeout(300) do
      sleep 0.05 until File.file?("release-notice-subject")
    end
  RUBY
  File.chmod(0o755, hold_script)
  File.write(
    File.join(root, "botster-package.json"),
    JSON.pretty_generate({
      name: "notice-subject.fixture",
      version: "1.0.0",
      kind: "plugin",
      botster: ">=0.1.0",
      source: { type: "path", path: "." },
      capabilities: [{ surface: "surfaces" }],
      entrypoints: [{ runtime: "lua", path: "plugin.lua", bootstrap: false }],
      session_types: [{
        id: "hold",
        label: "Held notice subject",
        description: "Session that waits so the Plan visit keeps its session binding.",
        role: "botster.agent",
        interaction: "interactive",
        traits: ["pipeline-step", "worktree-aware"],
        lifecycle: "task",
        command: "bin/hold.rb",
        target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
        context: ["prompt", "ticket_id", "metadata.run_id"]
      }]
    })
  )
end

def write_question_opened_sidecar(root)
  FileUtils.mkdir_p(root)
  File.write(File.join(root, "botster-package.json"), JSON.pretty_generate({
    name: "botster-workspaces",
    version: "1.0.0",
    kind: "plugin",
    botster: ">=0.1.0",
    source: { type: "path", path: "." },
    capabilities: [{ surface: "plugin_db", scope: "botster-workspaces" }],
    entrypoints: [{ runtime: "lua", path: "plugin.lua", bootstrap: false }]
  }))
  File.write(File.join(root, "plugin.lua"), <<~'LUA')
    local received = {}
    local plugin_db = botster.capabilities.plugin_db

    local function write_signal(key, payload)
      plugin_db.set({
        key = key,
        schema_version = 1,
        payload = payload,
        expected_revision = nil,
      })
    end

    local function has_release()
      local result = plugin_db.get({ key = "release" })
      return result ~= nil and result.record ~= nil
    end

    local function pause()
      local n = 0
      while n < 200000 do
        n = n + 1
      end
    end

    events.on("project-pipelines", "question.opened", function(event)
      received[#received + 1] = event
      write_signal("entered", { name = "question.opened" })
      while not has_release() do
        pause()
      end
    end)

    return botster.register({
      tools = {
        {
          name = "question_opened_sidecar.last_received",
          description = "Return question.opened payloads received in this sidecar worker generation.",
          input_schema = {
            type = "object",
            additionalProperties = false,
          },
          handler = "last_received",
          call = function()
            return { count = #received, last = received[#received] }
          end,
        },
      },
    })
  LUA
end

hub_source = File.realpath(ENV.fetch("BOTSTER_HUB_SOURCE") { raise "BOTSTER_HUB_SOURCE is required" })
hub_commit = IO.popen(["git", "-C", hub_source, "rev-parse", "HEAD"], &:read).strip
raise "unexpected Hub provenance #{hub_commit}" unless hub_commit == EXPECTED_HUB_COMMIT
hub_changes = IO.popen(["git", "-C", hub_source, "status", "--porcelain"], &:read)
raise "Hub provenance checkout is dirty:\n#{hub_changes}" unless hub_changes.empty?
lock = File.read(File.join(hub_source, "Cargo.lock"))
core_commit = lock.match(%r{name = "botster-core"\nversion = "[^"]+"\nsource = "git\+https://github\.com/trybotster/botster-core(?:\.git)?\?(?:branch=main|rev=[0-9a-f]+)#([0-9a-f]{40})"}m)&.captures&.first
raise "botster-core git provenance is missing from Cargo.lock" unless core_commit

# Produce the binaries after verifying clean source identity. A checkout path and
# HEAD alone do not prove that pre-existing target artifacts came from that revision.
run!("cargo", "build", "--locked", chdir: hub_source)
run!("cargo", "build", "--locked", "-p", "botster-core-daemon", "--bin", "botster-session-worker", chdir: hub_source)

hub = required_executable("BOTSTER_HUB_BIN")
session_worker = required_executable("BOTSTER_SESSION_WORKER_BIN")
target_prefix = File.join(hub_source, "target") + File::SEPARATOR
raise "BOTSTER_HUB_BIN was not built from BOTSTER_HUB_SOURCE" unless File.realpath(hub).start_with?(target_prefix)
raise "BOTSTER_SESSION_WORKER_BIN was not built from BOTSTER_HUB_SOURCE" unless File.realpath(session_worker).start_with?(target_prefix)

temporary_root = Dir.exist?("/private/tmp") ? "/private/tmp" : Dir.tmpdir
Dir.mktmpdir("bpp-", temporary_root) do |data_dir|
  downstream_root = File.join(data_dir, "downstream-workspaces")
  FileUtils.mkdir_p(downstream_root)
  run!("git", "init", "-b", "main", downstream_root)
  run!("git", "-C", downstream_root, "config", "user.email", "botster@example.invalid")
  run!("git", "-C", downstream_root, "config", "user.name", "Botster Acceptance")
  File.write(File.join(downstream_root, "README.md"), "# downstream Workspaces acceptance\n")
  run!("git", "-C", downstream_root, "add", "README.md")
  run!("git", "-C", downstream_root, "commit", "-m", "Initialize downstream acceptance repository")

  template_root = File.join(data_dir, "downstream-plan-template")
  FileUtils.mkdir_p(File.join(template_root, "bin"))
  File.write(File.join(template_root, "plugin.lua"), "return botster.register({})\n")
  plan_script = File.join(template_root, "bin", "plan.rb")
  File.write(plan_script, <<~'RUBY')
    #!/usr/bin/env ruby
    # frozen_string_literal: true

    require "json"
    require "socket"
    require "timeout"

    context_json = IO.popen([
      ENV.fetch("BOTSTER_HUB_BIN"),
      "context",
      "--data-dir", ENV.fetch("BOTSTER_HUB_DATA_DIR"),
      "--session-id", ENV.fetch("BOTSTER_SESSION_ID"),
      "--context-id", ENV.fetch("BOTSTER_CONTEXT_ID")
    ], &:read)
    raise "could not read managed session context" unless $?.success?

    context = JSON.parse(context_json)
    prompt = context.fetch("prompt")
    run_id = context.fetch("metadata.run_id")
    expected_repository_playbooks = [
      "[[botster-core-playbook]]",
      "[[botster-hub-playbook]]",
      "[[botster-hub-client-playbook]]",
      "[[botster-web-playbook]]",
      "[[botster-tui-playbook]]",
      "[[botster-tui-kit-playbook]]",
      "[[botster-workspaces-playbook]]",
      "[[botster-terminal-ghostty-playbook]]",
      "[[project-pipelines-playbook]]"
    ]
    missing_playbooks = expected_repository_playbooks.reject { |playbook| prompt.include?(playbook) }
    raise "repository charters were not resolved: #{missing_playbooks.join(", ")}" unless missing_playbooks.empty?
    raise "routing failure guard was not delivered" unless prompt.include?("Zero or multiple matches require a routing question; never substitute a generic charter or load every charter.")

    socket = UNIXSocket.new(ENV.fetch("BOTSTER_HUB_SOCKET"))
    socket.puts(JSON.generate({
      protocol: "botster-hub-daemon-v1",
      compatibility: {
        protocol: "botster-hub-daemon-v1",
        protocol_version: 6,
        required_features: [],
        minimum_conformance_fixture_revision: 1,
        client_name: "downstream-workspaces-plan-agent"
      }
    }))
    JSON.parse(socket.gets || raise("daemon closed before hello"))

    call_tool = lambda do |name, arguments|
      socket.puts(JSON.generate({ type: "plugin_mcp_call_tool", name: name, arguments: arguments }))
      response = JSON.parse(socket.gets || raise("daemon closed during #{name}"))
      raise "#{name} daemon error: #{response["error"]}" if response["error"]
      response.fetch("plugin_tool_result")
    end

    artifact = call_tool.call("project_pipelines.add_artifact", {
      id: "artifact_live_plan_agent",
      run_id: run_id,
      step_id: "botster_stack_plan",
      kind: "plan",
      summary: "Downstream Workspaces agent resolved the repository charter",
      payload: { repository_playbook: "[[botster-workspaces-playbook]]" }
    })
    gate = call_tool.call("project_pipelines.submit_gate", {
      run_id: run_id,
      step_id: "botster_stack_plan",
      gate_id: "plan_artifact",
      status: "passed",
      evidence: { artifact_id: "artifact_live_plan_agent", producer: "spawned_downstream_agent" }
    })
    advance = call_tool.call("project_pipelines.request_step_advance", {
      run_id: run_id,
      request_id: "live-plan-agent-advance"
    })
    raise "downstream agent failed to advance Plan" unless advance["ok"] && advance["step_id"] == "botster_stack_plan_review"

    File.write("downstream-plan-ran.json", JSON.pretty_generate({
      run_id: run_id,
      repository_playbook: "[[botster-workspaces-playbook]]",
      artifact_id: artifact.dig("artifact", "id"),
      gate_id: gate.dig("gate_result", "gate_id"),
      step_id: advance["step_id"]
    }))
    Timeout.timeout(120) do
      sleep 0.05 until File.file?("release-downstream-plan")
    end
  RUBY
  File.chmod(0o755, plan_script)
  File.write(
    File.join(template_root, "botster-package.json"),
    JSON.pretty_generate({
      name: "downstream-plan.fixture",
      version: "1.0.0",
      kind: "plugin",
      botster: ">=0.1.0",
      source: { type: "path", path: "." },
      capabilities: [{ surface: "surfaces" }],
      entrypoints: [{ runtime: "lua", path: "plugin.lua", bootstrap: false }],
      session_types: [{
        id: "plan",
        label: "Downstream Plan",
        description: "Deterministic downstream Plan acceptance session.",
        role: "botster.agent",
        interaction: "interactive",
        traits: ["pipeline-step", "worktree-aware"],
        lifecycle: "task",
        command: "bin/plan.rb",
        target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
        context: ["prompt", "ticket_id", "metadata.run_id"]
      }]
    })
  )

  socket_path = File.join(data_dir, "botster-hub.sock")
  log_path = File.join(data_dir, "botster-hub.log")
  log = File.open(log_path, "w")
  hub_pid = Process.spawn(
    hub,
    "start",
    "--data-dir",
    data_dir,
    "--session-worker-bin",
    session_worker,
    out: log,
    err: log
  )
  hub_status = nil
  failure = nil

  begin
    Timeout.timeout(20) do
      until File.socket?(socket_path)
        if Process.waitpid(hub_pid, Process::WNOHANG)
          hub_status = $?
          log.flush
          raise "isolated hub exited before creating its socket:\n#{File.read(log_path)}"
        end
        sleep 0.05
      end
    end

    run!(hub, "packages", "install", "--data-dir", data_dir, "--path", template_root)
    run!(hub, "packages", "enable", "--data-dir", data_dir, "downstream-plan.fixture")
    run!(hub, "packages", "install", "--data-dir", data_dir, "--path", ROOT)
    # An upgraded install reaches the enabled worker with no effective default: the Hub only
    # exposes configuration fields the installed manifest declares, and 0.3.0 renamed the key.
    # Enable first without configuring it so that exact state is proven against the real Hub,
    # then apply the documented operator repair and reload before the primary acceptance run.
    run!(hub, "packages", "enable", "--data-dir", data_dir, "project-pipelines")
    run!(File.join(ROOT, "script", "hub_acceptance_smoke"), socket_path, "verify_upgrade_gap", downstream_root)
    run!(
      hub,
      "packages", "config", "set", "--data-dir", data_dir,
      "project-pipelines",
      JSON.generate({ default_session_type_id: { type: "string", value: "downstream-plan.fixture/plan" } })
    )
    run!(hub, "packages", "disable", "--data-dir", data_dir, "project-pipelines")
    run!(hub, "packages", "enable", "--data-dir", data_dir, "project-pipelines")
    run!(File.join(ROOT, "script", "hub_acceptance_smoke"), socket_path, "primary", downstream_root)

    packages_socket = open_hub_socket(socket_path)
    begin
      packages_socket.puts(JSON.generate({ type: "list_packages" }))
      packages_response = JSON.parse(packages_socket.gets || raise("daemon closed during list_packages"))
      raise "list_packages failed: #{packages_response.inspect}" unless packages_response["kind"] == "packages"
      pipeline_package = packages_response.fetch("packages").find { |pkg| pkg["package_name"] == "project-pipelines" }
      raise "project-pipelines missing from packages frame" unless pipeline_package
      expected_reaction = {
        "owner" => "project-pipelines",
        "name" => "question.opened",
        "subject_scope" => "session",
        "text_pointer" => "/notice",
        "ttl_ms" => 10_000,
        "severity" => "warning"
      }
      reactions = pipeline_package["notice_reactions"]
      raise "notice_reactions mismatch: #{reactions.inspect}" unless reactions == [expected_reaction]
    ensure
      packages_socket.close
    end

    sidecar_root = File.join(data_dir, "question-opened-sidecar")
    write_question_opened_sidecar(sidecar_root)
    run!(hub, "packages", "install", "--data-dir", data_dir, "--path", sidecar_root)
    run!(hub, "packages", "enable", "--data-dir", data_dir, "botster-workspaces")

    sidecar_dir = File.join(data_dir, "plugin-data", "botster-workspaces")
    entered_path = File.join(sidecar_dir, "#{encode_plugin_store_key("entered")}.json")
    release_path = File.join(sidecar_dir, "#{encode_plugin_store_key("release")}.json")
    FileUtils.rm_f(entered_path)
    FileUtils.rm_f(release_path)

    socket = open_hub_socket(socket_path)
    begin
      context = call_hub_tool(socket, "project_pipelines.current_context", {})
      live_run = context.fetch("runs").find { |run| run["id"] == "run_live_authority" }
      raise "live run missing before question.opened proof" unless live_run
      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      opened = begin
        Timeout.timeout(8) do
          call_hub_tool(socket, "project_pipelines.ask_human", {
            id: "question_opened_live",
            run_id: live_run.fetch("id"),
            ticket_id: live_run.fetch("ticket_id"),
            step_id: "botster_stack_review",
            blocking: true,
            question: "Is the transient question.opened notice live?"
          })
        end
      rescue Timeout::Error
        raise "ask_human did not return; sidecar handler blocked the caller"
      end
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
      raise "ask_human failed: #{opened.inspect}" unless opened["ok"]
      puts "script/test-hub-flow: ask_human elapsed=#{elapsed}s sidecar-nonblock-ordering"
      begin
        Timeout.timeout(5) do
          sleep 0.02 until File.file?(entered_path)
        end
      rescue Timeout::Error
        found = Dir.glob(File.join(data_dir, "**", "*.json")).first(40)
        raise "sidecar entry signal was not written at #{entered_path}; data_dir=#{found.inspect}"
      end
      raise "sidecar released before the return-before-release bound was observed" if File.file?(release_path)
      entered_json = File.read(entered_path)
      raise "entered record is not a store row: #{entered_json}" unless entered_json.include?('"key"')
      File.write(release_path, entered_json.gsub('"entered"', '"release"').gsub('"name": "question.opened"', '"released": true'))
      delivered = nil
      Timeout.timeout(5) do
        loop do
          delivered = call_hub_tool(socket, "question_opened_sidecar.last_received", {})
          break if delivered["count"] == 1
          sleep 0.02
        end
      end
      payload = delivered.fetch("last")
      raise "sidecar delivered the wrong owner payload: #{payload.inspect}" unless payload["question_id"] == "question_opened_live"
      raise "sidecar notice mismatch: #{payload.inspect}" unless payload["notice"] == "Is the transient question.opened notice live?"
      raise "sidecar kind mismatch: #{payload.inspect}" unless payload["kind"] == "human"
      raise "sidecar must record exactly one payload" unless delivered["count"] == 1

    ensure
      socket.close
    end

    hold_root = File.join(data_dir, "notice-subject-hold")
    write_notice_subject_hold_fixture(hold_root)
    run!(hub, "packages", "install", "--data-dir", data_dir, "--path", hold_root)
    run!(hub, "packages", "enable", "--data-dir", data_dir, "notice-subject.fixture")
    run!(hub, "packages", "disable", "--data-dir", data_dir, "project-pipelines")
    run!(hub, "packages", "enable", "--data-dir", data_dir, "project-pipelines")
    run!(hub, "packages", "disable", "--data-dir", data_dir, "botster-workspaces")
    run!(hub, "packages", "enable", "--data-dir", data_dir, "botster-workspaces")

    hold_cleanup = nil
    matching_events = nil
    mismatch_events = nil
    begin
      subject_socket = open_hub_socket(socket_path)
      begin
        live_context = call_hub_tool(subject_socket, "project_pipelines.current_context", {})
        live_run = live_context.fetch("runs").find { |run| run["id"] == "run_live_authority" }
        raise "live run missing before notice subject proof" unless live_run
        live_ticket_id = live_run.fetch("ticket_id")
        notice_run = call_hub_tool(subject_socket, "project_pipelines.start_run", {
          id: "run_notice_subject",
          ticket_id: live_ticket_id,
          pipeline_id: "botster_stack_delivery",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          branch: "project-pipelines/notice-subject-hold",
          base_ref: "main"
        })
        raise "notice subject run failed: #{notice_run.inspect}" unless notice_run["ok"]
        subject_socket.puts(JSON.generate({
          type: "list_session_types_for_target",
          target_id: "tgt_71266a8d976d4535902ffed09c18a7ba"
        }))
        types_response = JSON.parse(subject_socket.gets || raise("daemon closed during list_session_types_for_target"))
        raise "list_session_types_for_target failed: #{types_response.inspect}" if types_response["error"]
        type_ids = Array(types_response["session_types"]).map { |row| row["session_type_id"] || row["id"] }
        unless type_ids.include?("notice-subject.fixture/hold")
          raise "held session type missing at admitted target: #{type_ids.inspect}"
        end
        spawned = call_hub_tool(subject_socket, "project_pipelines.spawn_ticket_session", {
          run_id: "run_notice_subject",
          step_id: "botster_stack_plan",
          session_type_id: "notice-subject.fixture/hold",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          request_id: "session_request_notice_subject"
        })
        raise "notice subject spawn failed: #{spawned.inspect}" unless spawned["ok"]
        hold_session_id = spawned.dig("activation", "session_id") || spawned.dig("activation", "result", "session_id")
        raise "notice subject spawn did not return a session id: #{spawned.inspect}" unless hold_session_id.is_a?(String) && !hold_session_id.empty?
        hold_cleanup = HeldSessionCleanup.new(
          hub: hub,
          data_dir: data_dir,
          socket_path: socket_path,
          session_id: hold_session_id
        )
        hold_worktree = spawned.dig("activation", "result", "worktree_path")
        raise "notice subject spawn did not return a worktree" unless hold_worktree
        hold_cleanup.worktree = hold_worktree
        ready_path = File.join(hold_worktree, "notice-subject-ready.json")
        Timeout.timeout(20) do
          sleep 0.05 until File.file?(ready_path)
        end
        hold_cleanup.observe_descendants!
        raise "held fixture produced no live descendants" if hold_cleanup.descendant_pids.empty?
        ask_context = call_hub_tool(subject_socket, "project_pipelines.current_context", { run_id: "run_notice_subject" })
        ask_run = ask_context.fetch("run")
        raise "notice subject run left Plan" unless ask_run["current_step_id"] == "botster_stack_plan"
        plan_visit = ask_context.fetch("run_steps").find { |step| step["id"] == ask_run["current_run_step_id"] }
        raise "notice subject Plan visit missing: #{ask_context.inspect}" unless plan_visit && plan_visit["step_id"] == "botster_stack_plan"
        expected_subject = plan_visit["agent_session_uuid"]
        raise "notice subject Plan visit has no session binding: #{plan_visit.inspect}" unless expected_subject.is_a?(String) && !expected_subject.empty?

        matching_events = open_event_socket(socket_path, "project-pipelines-notice-match")
        mismatch_events = open_event_socket(socket_path, "project-pipelines-notice-mismatch")
        subscribe_package_event(matching_events, "sub-notice-match", "project-pipelines", "question.opened", [expected_subject])
        subscribe_package_event(mismatch_events, "sub-notice-mismatch", "project-pipelines", "question.opened", ["not-this-session"])

        bound_question = "Does the session subject target this notice?"
        opened = call_hub_tool(subject_socket, "project_pipelines.ask_human", {
          id: "question_notice_subject",
          run_id: "run_notice_subject",
          ticket_id: live_ticket_id,
          question: bound_question
        })
        raise "notice subject ask_human failed: #{opened.inspect}" unless opened["ok"]
        matched = wait_package_event(matching_events, timeout: 5)
        raise "matching subscription owner mismatch: #{matched.inspect}" unless matched["owner"] == "project-pipelines"
        raise "matching subscription name mismatch: #{matched.inspect}" unless matched["name"] == "question.opened"
        matched_payload = matched.fetch("payload")
        raise "matching subject mismatch: #{matched_payload.inspect}" unless matched_payload["subject"] == expected_subject
        raise "matching notice text mismatch" unless resolve_notice_text(matched_payload, "/notice") == bound_question
        assert_no_package_event(mismatch_events, timeout: 3, label: "mismatched-subject subscription")

        unbound_run = call_hub_tool(subject_socket, "project_pipelines.start_run", {
          id: "run_notice_unbound",
          ticket_id: live_ticket_id,
          pipeline_id: "botster_stack_delivery",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          branch: "project-pipelines/notice-unbound",
          base_ref: "main"
        })
        raise "unbound notice run failed: #{unbound_run.inspect}" unless unbound_run["ok"]
        unbound_context = call_hub_tool(subject_socket, "project_pipelines.current_context", { run_id: "run_notice_unbound" })
        unbound_visit = unbound_context.fetch("run_steps").find { |step| step["id"] == unbound_context.dig("run", "current_run_step_id") }
        raise "unbound Plan visit missing" unless unbound_visit && unbound_visit["step_id"] == "botster_stack_plan"
        raise "unbound Plan visit must have no session binding: #{unbound_visit.inspect}" unless unbound_visit["agent_session_uuid"].to_s.empty?

        sidecar_before = call_hub_tool(subject_socket, "question_opened_sidecar.last_received", {})
        unbound_question = "Does an unbound question omit subject?"
        unbound_opened = call_hub_tool(subject_socket, "project_pipelines.ask_human", {
          id: "question_notice_unbound",
          run_id: "run_notice_unbound",
          ticket_id: live_ticket_id,
          question: unbound_question
        })
        raise "unbound ask_human failed: #{unbound_opened.inspect}" unless unbound_opened["ok"]
        sidecar_after = nil
        Timeout.timeout(5) do
          loop do
            sidecar_after = call_hub_tool(subject_socket, "question_opened_sidecar.last_received", {})
            break if sidecar_after["count"].to_i == sidecar_before["count"].to_i + 1
            sleep 0.02
          end
        end
        unbound_payload = sidecar_after.fetch("last")
        raise "sidecar missed the unbound question: #{unbound_payload.inspect}" unless unbound_payload["question_id"] == "question_notice_unbound"
        raise "unbound payload must omit subject: #{unbound_payload.inspect}" if unbound_payload.key?("subject")
        assert_no_package_event(matching_events, timeout: 3, label: "session-filtered subscription after unbound emit")
        hold_cleanup.shutdown_and_wait!
        hold_cleanup.disarm
      ensure
        subject_socket.close
      end
    ensure
      hold_cleanup.shutdown_and_wait! if hold_cleanup&.armed
      matching_events.close if matching_events
      mismatch_events.close if mismatch_events
    end

    cleanup_fail = nil
    begin
      fail_socket = open_hub_socket(socket_path)
      begin
        fail_context = call_hub_tool(fail_socket, "project_pipelines.current_context", {})
        fail_run_ticket = fail_context.fetch("runs").find { |run| run["id"] == "run_live_authority" }.fetch("ticket_id")
        fail_run = call_hub_tool(fail_socket, "project_pipelines.start_run", {
          id: "run_notice_cleanup_fail",
          ticket_id: fail_run_ticket,
          pipeline_id: "botster_stack_delivery",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          branch: "project-pipelines/notice-cleanup-fail",
          base_ref: "main"
        })
        raise "cleanup-fail run failed: #{fail_run.inspect}" unless fail_run["ok"]
        fail_spawned = call_hub_tool(fail_socket, "project_pipelines.spawn_ticket_session", {
          run_id: "run_notice_cleanup_fail",
          step_id: "botster_stack_plan",
          session_type_id: "notice-subject.fixture/hold",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          request_id: "session_request_notice_cleanup_fail"
        })
        raise "cleanup-fail spawn failed: #{fail_spawned.inspect}" unless fail_spawned["ok"]
        fail_session_id = fail_spawned.dig("activation", "session_id") || fail_spawned.dig("activation", "result", "session_id")
        raise "cleanup-fail spawn did not return a session id" unless fail_session_id.is_a?(String) && !fail_session_id.empty?
        cleanup_fail = HeldSessionCleanup.new(
          hub: hub,
          data_dir: data_dir,
          socket_path: socket_path,
          session_id: fail_session_id
        )
        fail_worktree = fail_spawned.dig("activation", "result", "worktree_path")
        raise "cleanup-fail spawn did not return a worktree" unless fail_worktree
        cleanup_fail.worktree = fail_worktree
        fail_ready = File.join(fail_worktree, "notice-subject-ready.json")
        Timeout.timeout(20) do
          sleep 0.05 until File.file?(fail_ready)
        end
        cleanup_fail.observe_descendants!
        raise "cleanup-fail fixture produced no live descendants" if cleanup_fail.descendant_pids.empty?
        raise "logical session missing before deliberate failure" unless logical_session_present?(socket_path, fail_session_id)
        raise "deliberate held-session cleanup failure after readiness"
      ensure
        fail_socket.close if fail_socket
      end
    rescue RuntimeError => error
      raise error unless error.message == "deliberate held-session cleanup failure after readiness"
    ensure
      cleanup_fail.shutdown_and_wait! if cleanup_fail&.armed
    end
    raise "cleanup-fail session owner was not armed" unless cleanup_fail
    raise "cleanup-fail logical session remained" if logical_session_present?(socket_path, cleanup_fail.session_id)
    survivors = cleanup_fail.descendant_pids.select { |pid| process_alive?(pid) }
    raise "cleanup-fail descendants remained: #{survivors.inspect}" unless survivors.empty?
    cleanup_fail.disarm

    question_sub = nil
    session_sub = nil
    published_question_seq = nil
    published_session_seq = nil
    question_sub, = open_held_entity_subscription(socket_path, "project-pipelines.question", "question-live-mutation")
    session_sub, = open_held_entity_subscription(socket_path, "project-pipelines.session_request", "session-request-live-mutation")
    begin
      live_socket = open_hub_socket(socket_path)
      begin
        live_context = call_hub_tool(live_socket, "project_pipelines.current_context", {})
        live_run = live_context.fetch("runs").find { |run| run["id"] == "run_live_authority" }
        raise "live run missing before mutation publish proof" unless live_run
        published_question = call_hub_tool(live_socket, "project_pipelines.ask_human", {
          id: "question_live_mutation_publish",
          run_id: live_run.fetch("id"),
          ticket_id: live_run.fetch("ticket_id"),
          step_id: "botster_stack_implement",
          blocking: false,
          question: "Does a held question subscription receive the upsert?"
        })
        raise "live mutation ask_human failed: #{published_question.inspect}" unless published_question["ok"]
        opened_frame = wait_entity_upsert(question_sub, "project-pipelines.question", "question_live_mutation_publish")
        opened_row = opened_frame["entity"] || opened_frame["record"] || opened_frame
        raise "held question upsert missing question text: #{opened_frame.inspect}" unless opened_row["question"] == "Does a held question subscription receive the upsert?"
        raise "held question upsert was not open: #{opened_frame.inspect}" unless opened_row["status"] == "open"

        answered = call_hub_tool(live_socket, "project_pipelines.answer_question", {
          question_id: "question_live_mutation_publish",
          answer: "Yes; the held subscription stayed open."
        })
        raise "live mutation answer_question failed: #{answered.inspect}" unless answered["ok"]
        answered_frame = wait_entity_upsert(question_sub, "project-pipelines.question", "question_live_mutation_publish")
        answered_row = answered_frame["entity"] || answered_frame["record"] || answered_frame
        raise "held question status upsert missing: #{answered_frame.inspect}" unless answered_row["status"] == "answered"

        mutation_ticket = call_hub_tool(live_socket, "project_pipelines.create_ticket", {
          id: "ticket_live_mutation_publish",
          project_id: live_context.fetch("tickets").find { |ticket| ticket["id"] == live_run.fetch("ticket_id") }.fetch("project_id"),
          title: "Live session_request mutation publish"
        })
        raise "mutation ticket failed: #{mutation_ticket.inspect}" unless mutation_ticket["ok"]
        mutation_run = call_hub_tool(live_socket, "project_pipelines.start_run", {
          id: "run_live_mutation_publish",
          ticket_id: "ticket_live_mutation_publish",
          pipeline_id: "botster_stack_delivery",
          spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
          branch: "project-pipelines/live-mutation-publish",
          base_ref: "main"
        })
        raise "mutation run failed: #{mutation_run.inspect}" unless mutation_run["ok"]
        spawned = call_hub_tool(live_socket, "project_pipelines.spawn_ticket_session", {
          run_id: "run_live_mutation_publish",
          step_id: "botster_stack_plan",
          request_id: "session_request_live_mutation_publish"
        })
        raise "mutation spawn failed: #{spawned.inspect}" unless spawned["ok"]
        spawned_worktree = spawned.dig("activation", "result", "worktree_path")
        File.write(File.join(spawned_worktree, "release-downstream-plan"), "release\n") if spawned_worktree
        session_frame = nil
        deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 12
        loop do
          remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
          raise "held session_request upsert with session_id did not arrive: last=#{session_frame.inspect}" if remaining <= 0
          session_frame = wait_entity_frame(session_sub, timeout: remaining)
          next unless session_frame["type"] == "entity_upsert"
          next unless session_frame["entity_type"] == "project-pipelines.session_request" || session_frame["family"] == "project-pipelines.session_request"
          next unless session_frame["id"] == "session_request_live_mutation_publish"
          session_row = session_frame["entity"] || session_frame["record"] || session_frame
          break if session_row["session_id"]
        end
        published_question_seq = [opened_frame["snapshot_seq"], answered_frame["snapshot_seq"]].compact.max
        published_session_seq = session_frame["snapshot_seq"]
      ensure
        live_socket.close
      end
    ensure
      question_sub.close if question_sub
      session_sub.close if session_sub
      question_sub = nil
      session_sub = nil
    end

    fresh_question = subscribe_entity_snapshot(socket_path, "project-pipelines.question", "question-live-mutation-floor")
    raise "fresh question snapshot_seq #{fresh_question["snapshot_seq"]} is behind published floor #{published_question_seq}" if published_question_seq && fresh_question["snapshot_seq"].to_i < published_question_seq.to_i
    fresh_question_row = fresh_question.fetch("items").find { |item| item["id"] == "question_live_mutation_publish" }
    raise "fresh question snapshot omitted the mutated row" unless fresh_question_row && fresh_question_row["status"] == "answered"

    fresh_session = subscribe_entity_snapshot(socket_path, "project-pipelines.session_request", "session-request-live-mutation-floor")
    raise "fresh session_request snapshot_seq #{fresh_session["snapshot_seq"]} is behind published floor #{published_session_seq}" if published_session_seq && fresh_session["snapshot_seq"].to_i < published_session_seq.to_i
    fresh_session_row = fresh_session.fetch("items").find { |item| item["id"] == "session_request_live_mutation_publish" }
    raise "fresh session_request snapshot omitted session_id" unless fresh_session_row && fresh_session_row["session_id"]

    run!(hub, "packages", "disable", "--data-dir", data_dir, "botster-workspaces")
    run!(hub, "shutdown", "--data-dir", data_dir)
    Timeout.timeout(10) do
      Process.waitpid(hub_pid)
      hub_status = $?
    end
    raise "isolated hub failed before restart" unless hub_status.success?
    hub_status = nil
    File.delete(socket_path) if File.exist?(socket_path)

    hub_pid = Process.spawn(
      hub,
      "start",
      "--data-dir",
      data_dir,
      "--session-worker-bin",
      session_worker,
      out: log,
      err: log
    )
    Timeout.timeout(20) do
      until File.socket?(socket_path)
        if Process.waitpid(hub_pid, Process::WNOHANG)
          hub_status = $?
          log.flush
          raise "isolated hub exited during restart:\n#{File.read(log_path)}"
        end
        sleep 0.05
      end
    end
    sleep 5
    run!(File.join(ROOT, "script", "hub_acceptance_smoke"), socket_path, "verify_restart", downstream_root)

    restart_socket = open_hub_socket(socket_path)
    begin
      restart_context = call_hub_tool(restart_socket, "project_pipelines.current_context", {})
      restart_question = restart_context.fetch("questions").find { |question| question["id"] == "question_opened_live" }
      raise "question.opened subject did not survive Hub restart" unless restart_question
      raise "restart recovered the question from event replay" unless restart_question["question"] == "Is the transient question.opened notice live?"
      question_snapshot = subscribe_entity_snapshot(socket_path, "project-pipelines.question", "question-opened-restart")
      snapshot_row = question_snapshot.fetch("items").find { |item| item["id"] == "question_opened_live" }
      raise "entity_provider did not recover the durable question after restart" unless snapshot_row

      project_id = restart_context.fetch("tickets").find { |ticket| ticket["id"] == restart_question["ticket_id"] }.fetch("project_id")
      merge_ticket = call_hub_tool(restart_socket, "project_pipelines.create_ticket", {
        id: "ticket_live_pr_merged",
        project_id: project_id,
        title: "Live provider merge"
      })
      raise "merge ticket failed: #{merge_ticket.inspect}" unless merge_ticket["ok"]
      merge_run = call_hub_tool(restart_socket, "project_pipelines.start_run", {
        id: "run_live_pr_merged",
        ticket_id: "ticket_live_pr_merged",
        pipeline_id: "botster_stack_delivery"
      })
      raise "merge run failed: #{merge_run.inspect}" unless merge_run["ok"]
      linked = call_hub_tool(restart_socket, "project_pipelines.link_pr", {
        run_id: "run_live_pr_merged",
        url: "https://example.invalid/project-pipelines/pull/9",
        status: "merged",
        merge_commit: "cafef00d"
      })
      raise "merged link_pr failed: #{linked.inspect}" unless linked["ok"]
      raise "merged link_pr did not persist closed run: #{linked.inspect}" unless linked.dig("run", "status") == "closed"
      raise "merged link_pr did not persist closed ticket: #{linked.inspect}" unless linked.dig("ticket", "status") == "closed"
      merged_context = call_hub_tool(restart_socket, "project_pipelines.current_context", { run_id: "run_live_pr_merged" })
      ticket = merged_context.fetch("tickets").find { |row| row["id"] == "ticket_live_pr_merged" }
      run = merged_context.fetch("runs").find { |row| row["id"] == "run_live_pr_merged" }
      raise "current_context did not show the durable merge close: #{merged_context.inspect}" unless ticket && ticket["status"] == "closed" && run && run["status"] == "closed"
    ensure
      restart_socket.close
    end

    run!(hub, "packages", "enable", "--data-dir", data_dir, "botster-workspaces")
    sidecar_socket = open_hub_socket(socket_path)
    begin
      replayed = call_hub_tool(sidecar_socket, "question_opened_sidecar.last_received", {})
      raise "sidecar replayed question.opened after Hub restart: #{replayed.inspect}" unless replayed["count"] == 0
    ensure
      sidecar_socket.close
    end
  rescue StandardError => error
    failure = error
  ensure
    shutdown_ok = hub_status ? true : system(hub, "shutdown", "--data-dir", data_dir, out: File::NULL, err: File::NULL)
    unless hub_status
      begin
        Timeout.timeout(10) do
          Process.waitpid(hub_pid)
          hub_status = $?
        end
      rescue Timeout::Error
        failure ||= RuntimeError.new("isolated hub did not stop within 10 seconds")
        begin
          Process.kill("TERM", hub_pid)
        rescue Errno::ESRCH
          nil
        end
        begin
          Timeout.timeout(5) do
            Process.waitpid(hub_pid)
            hub_status = $?
          end
        rescue Timeout::Error
          begin
            Process.kill("KILL", hub_pid)
          rescue Errno::ESRCH
            nil
          end
          begin
            Timeout.timeout(5) do
              Process.waitpid(hub_pid)
              hub_status = $?
            end
          rescue Timeout::Error
            failure ||= RuntimeError.new("isolated hub could not be reaped after KILL")
          rescue Errno::ECHILD
            nil
          end
        rescue Errno::ECHILD
          nil
        end
      rescue Errno::ECHILD, Errno::ESRCH
        nil
      end
    end

    failure ||= RuntimeError.new("isolated hub cleanup failed") unless shutdown_ok && hub_status&.success?
    if failure
      log.flush
      warn "isolated hub log tail:"
      warn File.readlines(log_path).last(80).join
    end
    log.close unless log.closed?
  end

  raise failure if failure
end

puts "script/test-hub-flow: ok hub=#{hub_commit} core=#{core_commit}"
