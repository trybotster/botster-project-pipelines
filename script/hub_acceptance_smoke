assert(live_waiting_context.fetch("run_steps").length == 1, "waiting created Implement before clearance")
assert(live_waiting_context.fetch("session_requests").none? { |request_row| request_row["run_id"] == "run_live_dependency_waiting" }, "waiting created a downstream request")

# A run an operator ended while it was waiting must stay ended through real persistence:
# later clearance of its last blocker may not resurrect it into an agent step.
call_tool(socket, "project_pipelines.create_ticket", {
  id: "ticket_live_waiting_cancelled",
  project_id: project_id,
  target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
  title: "Live waiting cancelled"
})
live_cancelled_started = call_tool(socket, "project_pipelines.start_run", {
  id: "run_live_waiting_cancelled",
  ticket_id: "ticket_live_waiting_cancelled",
  pipeline_id: "pipeline_live_dependency_waiting",
  spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
  branch: "project-pipelines/live-waiting-cancelled",
  base_ref: "main"
})
call_tool(socket, "project_pipelines.create_ticket", {
  id: "ticket_live_waiting_cancelled_blocker",
  project_id: project_id,
  title: "Live waiting cancelled blocker"
})
call_tool(socket, "project_pipelines.add_ticket_dependency", {
  id: "dependency_live_waiting_cancelled",
  ticket_id: "ticket_live_waiting_cancelled",
  dependency_ticket_id: "ticket_live_waiting_cancelled_blocker"
})
call_tool(socket, "project_pipelines.submit_review", {
  run_id: "run_live_waiting_cancelled",
  run_step_id: live_cancelled_started.dig("run_step", "id"),
  step_id: "live_waiting_plan_review",
  verdict: "approved"
})
live_cancelled_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: "run_live_waiting_cancelled",
  request_id: "advance_live_waiting_cancelled"
})
assert(live_cancelled_advance["ok"] == false && live_cancelled_advance.dig("error", "code") == "ticket_dependencies_unmet", "approved live review did not wait before cancellation")
call_tool(socket, "project_pipelines.cancel_run", { run_id: "run_live_waiting_cancelled", reason: "operator ended the run while it waited" })
cancelled_waiting_context = call_tool(socket, "project_pipelines.current_context", { run_id: "run_live_waiting_cancelled" })
assert(cancelled_waiting_context.dig("run", "status") == "cancelled", "cancel_run did not end the waiting run")
assert(!cancelled_waiting_context.dig("run", "waiting_transition"), "cancel_run left durable waiting state behind")
call_tool(socket, "project_pipelines.close_ticket", { ticket_id: "ticket_live_waiting_cancelled_blocker" })
resurrection_context = call_tool(socket, "project_pipelines.current_context", { run_id: "run_live_waiting_cancelled" })
assert(resurrection_context.dig("run", "status") == "cancelled", "clearing the blocker reactivated a cancelled run")
assert(resurrection_context.dig("run", "current_step_id") == "live_waiting_plan_review", "clearing the blocker advanced a cancelled run")
assert(resurrection_context.fetch("run_steps").length == 1, "clearing the blocker created an Implement visit on a cancelled run")
assert(resurrection_context.fetch("session_requests").none? { |request_row| request_row["run_id"] == "run_live_waiting_cancelled" }, "clearing the blocker spawned on a cancelled run")

# Retained waiting state must be live, not stranded: once its dependencies are satisfied,
# the mutation that restores authorization is itself what resumes the run.
call_tool(socket, "project_pipelines.create_ticket", {
  id: "ticket_live_waiting_reauth",
  project_id: project_id,
  target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
  title: "Live waiting reauthorization"
})
live_reauth_started = call_tool(socket, "project_pipelines.start_run", {
  id: "run_live_waiting_reauth",
  ticket_id: "ticket_live_waiting_reauth",
  pipeline_id: "pipeline_live_dependency_waiting",
  spawn_target_id: "tgt_71266a8d976d4535902ffed09c18a7ba",
  branch: "project-pipelines/live-waiting-reauth",
  base_ref: "main"
})
call_tool(socket, "project_pipelines.create_ticket", {
  id: "ticket_live_waiting_reauth_blocker",
  project_id: project_id,
  title: "Live waiting reauthorization blocker"
})
call_tool(socket, "project_pipelines.add_ticket_dependency", {
  id: "dependency_live_waiting_reauth",
  ticket_id: "ticket_live_waiting_reauth",
  dependency_ticket_id: "ticket_live_waiting_reauth_blocker"
})
call_tool(socket, "project_pipelines.submit_review", {
  run_id: "run_live_waiting_reauth",
  run_step_id: live_reauth_started.dig("run_step", "id"),
  step_id: "live_waiting_plan_review",
  verdict: "approved"
})
live_reauth_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: "run_live_waiting_reauth",
  request_id: "advance_live_waiting_reauth"
})
assert(live_reauth_advance["ok"] == false && live_reauth_advance.dig("error", "code") == "ticket_dependencies_unmet", "approved live review did not wait before reauthorization")
call_tool(socket, "project_pipelines.submit_review", {
  run_id: "run_live_waiting_reauth",
  run_step_id: live_reauth_started.dig("run_step", "id"),
  step_id: "live_waiting_plan_review",
  verdict: "approved",
  findings: [{ id: "finding_live_waiting_reauth", severity: "high", title: "Late blocking finding" }]
})
call_tool(socket, "project_pipelines.close_ticket", { ticket_id: "ticket_live_waiting_reauth_blocker" })
unauthorized_context = call_tool(socket, "project_pipelines.current_context", { run_id: "run_live_waiting_reauth" })
assert(unauthorized_context.dig("run", "current_step_id") == "live_waiting_plan_review", "a blocking finding did not hold the woken transition")
assert(unauthorized_context.dig("run", "waiting_transition", "unauthorized") == true, "cleared dependencies did not record the stale authorization")
assert(unauthorized_context.fetch("run_steps").length == 1, "an unauthorized wakeup created an Implement visit")
assert(unauthorized_context.fetch("session_requests").none? { |request_row| request_row["run_id"] == "run_live_waiting_reauth" }, "an unauthorized wakeup spawned")

# The dependency-blocked advance above persisted a pending advance request, so retrying the
# same request_id is an ordinary call and must not bypass that hold.
stale_retry = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: "run_live_waiting_reauth",
  request_id: "advance_live_waiting_reauth"
})
assert(stale_retry["ok"] == false && stale_retry.dig("error", "code") == "transition_authorization_changed", "a correlated retry bypassed the stale-authorization hold")
retried_context = call_tool(socket, "project_pipelines.current_context", { run_id: "run_live_waiting_reauth" })
assert(retried_context.dig("run", "current_step_id") == "live_waiting_plan_review", "a correlated retry advanced past the hold")
assert(retried_context.fetch("run_steps").length == 1, "a correlated retry created an Implement visit")
assert(retried_context.fetch("session_requests").none? { |request_row| request_row["run_id"] == "run_live_waiting_reauth" }, "a correlated retry spawned")
call_tool(socket, "project_pipelines.resolve_finding", { finding_id: "finding_live_waiting_reauth", resolution: "Resolved so the retained waiting transition can resume" })
reauthorized_context = call_tool(socket, "project_pipelines.current_context", { run_id: "run_live_waiting_reauth" })
assert(reauthorized_context.dig("run", "current_step_id") == "live_waiting_implement", "resolving the blocking finding did not resume the retained waiting transition")
assert(!reauthorized_context.dig("run", "waiting_transition"), "resuming did not consume the waiting state")
assert(reauthorized_context.fetch("run_steps").length == 2, "resuming created more than one Implement visit")
assert(call_tool(socket, "project_pipelines.list_ticket_dependencies", { ticket_id: "ticket_live_waiting_reauth" }).fetch("dependencies").length == 1, "resuming required changing a dependency row")

final_context = call_tool(socket, "project_pipelines.current_context", {})
assert(final_context.fetch("runs").any? { |record| record["id"] == run_id }, "current context missing live run")
run_gate_results = final_context.fetch("gate_results").select { |record| record["run_id"] == run_id }
assert(run_gate_results.length == 5 && run_gate_results.all? { |record| record["run_step_id"].to_s != "" }, "visit-scoped run gate results missing")
run_reviews = final_context.fetch("reviews").select { |record| record["run_id"] == run_id }
assert(run_reviews.length == 2 && run_reviews.map { |record| record["run_step_id"] }.uniq.length == 2, "visit-scoped run reviews missing")
assert(final_context.fetch("findings").any? { |record| record["run_id"] == run_id && record["status"] == "resolved" }, "resolved finding missing")
assert(final_context.fetch("questions").any? { |record| record["run_id"] == run_id && record["status"] == "answered" }, "answered question missing")
assert(final_context.fetch("pr_links").count { |record| record["run_id"] == run_id } == 1, "PR link missing")
assert(final_context.fetch("questions").none? { |record| record["question"].to_s.downcase.include?("routing") }, "downstream Plan asked a repository routing question")
initial_run_snapshot = subscribe_entity_snapshot(socket_path, "project-pipelines.run", "project-pipelines-run-initial")
reconnect_run_snapshot = subscribe_entity_snapshot(socket_path, "project-pipelines.run", "project-pipelines-run-reconnect")
assert(initial_run_snapshot.fetch("items") == final_context.fetch("runs"), "initial run snapshot disagrees with committed context")
assert(reconnect_run_snapshot.fetch("items") == final_context.fetch("runs"), "reconnect run snapshot disagrees with committed context")
assert(reconnect_run_snapshot.fetch("snapshot_seq") == initial_run_snapshot.fetch("snapshot_seq") + 1, "reconnect must invoke a fresh run provider snapshot")

