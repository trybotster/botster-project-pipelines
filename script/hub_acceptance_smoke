#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "socket"

socket_path = ARGV.fetch(0) do
  warn "usage: script/hub_acceptance_smoke <botster-hub.sock> [verify_restart]"
  exit 1
end

restart_verification = ARGV[1] == "verify_restart"
downstream_root = ARGV[2]

def assert(condition, message)
  raise message unless condition
end

socket = UNIXSocket.new(socket_path)
socket.puts(JSON.generate({
  protocol: "botster-hub-daemon-v1",
  compatibility: {
    protocol: "botster-hub-daemon-v1",
    minimum_protocol_version: 1,
    required_features: %w[plugin_surface_render plugin_surface_action],
    minimum_conformance_fixture_revision: 1,
    client_name: "botster-project-pipelines-acceptance-smoke"
  }
}))
hello = JSON.parse(socket.gets || raise("daemon closed before hello"))
assert(hello["protocol"] == "botster-hub-daemon-v1", "daemon hello failed")

def request(socket, payload)
  socket.puts(JSON.generate(payload))
  response = JSON.parse(socket.gets || raise("daemon closed during #{payload.fetch(:type)}"))
  raise "daemon #{payload.fetch(:type)} failed: #{response["error"]}" if response["error"]

  response
end

def call_tool(socket, name, arguments)
  response = request(socket, {
    type: "plugin_mcp_call_tool",
    name: name,
    arguments: arguments
  })
  assert(response["kind"] == "plugin_mcp_tool_result", "#{name} returned #{response["kind"]}")
  response.fetch("plugin_tool_result")
end

def render_surface(socket)
  response = request(socket, {
    type: "plugin_surface_render",
    package_name: "project-pipelines",
    surface_id: "project-pipelines.home",
    payload: {}
  })
  assert(response["kind"] == "plugin_surface", "render did not return plugin_surface")
  surface = response.fetch("plugin_surface")
  assert(surface.fetch("package_name") == "project-pipelines", "render package identity mismatch")
  assert(surface.fetch("surface_id") == "project-pipelines.home", "render surface identity mismatch")
  surface.fetch("body")
end

def each_node(node, &block)
  yield node
  each_node(node["node"], &block) if node["node"].is_a?(Hash)
  each_node(node["item_template"], &block) if node["item_template"].is_a?(Hash)
  each_node(node["empty_template"], &block) if node["empty_template"].is_a?(Hash)
  Array(node["children"]).each { |child| each_node(child, &block) }
  (node["slots"] || {}).each_value do |children|
    Array(children).each { |child| each_node(child, &block) }
  end
end

def find_node(root, id)
  found = nil
  each_node(root) { |node| found ||= node if node["id"] == id }
  found
end

def dispatch_action(socket, action_id:, request_id:, node_id: nil, kind: "submit", values: nil, payload: nil)
  # This harness is the client, so kind is authored here rather than observed
  # from a Hub-generated or renderer-generated dispatch.
  action_request = {
    request_id: request_id,
    surface_id: "project-pipelines.home",
    action_id: action_id,
    kind: kind
  }
  action_request[:node_id] = node_id if node_id
  action_request[:values] = values if values
  action_request[:payload] = payload if payload
  response = request(socket, {
    type: "plugin_surface_action",
    package_name: "project-pipelines",
    request: action_request
  })
  assert(response["kind"] == "plugin_action_result", "#{action_id} did not return plugin_action_result")
  result = response.fetch("plugin_action_result")
  assert(result["request_id"] == request_id, "#{action_id} request identity mismatch")
  assert(result["surface_id"] == "project-pipelines.home", "#{action_id} surface identity mismatch")
  assert(result["action_id"] == action_id, "#{action_id} action identity mismatch")
  if node_id
    assert(result["node_id"] == node_id, "#{action_id} node identity mismatch")
  else
    assert(!result.key?("node_id"), "#{action_id} must preserve absent node identity")
  end
  result
end

unless restart_verification
  raise "downstream target root is required" unless downstream_root
  target = request(socket, {
    type: "create_spawn_target",
    target_id: "tgt_3dfae49c02454037bf13554f552baf7f",
    label: "Downstream TUI-kit acceptance",
    root: downstream_root,
    enabled: true,
    kind: "git",
    base_ref: "main",
    metadata: { repository: "trybotster/botster-tui-kit" }
  })
  assert(target["kind"] == "spawn_targets", "downstream TUI-kit target admission failed")
end

initial_context = call_tool(socket, "project_pipelines.current_context", {})
stack_definitions = initial_context.fetch("pipeline_definitions").select { |definition| definition["source_id"] == "botster_stack_delivery" }
assert(stack_definitions.length == 1, "clean package must reconcile exactly one Stack Delivery definition")
assert(stack_definitions.first["source_authority"] == "trybotster/botster-project-pipelines:plugin.lua", "standalone source authority mismatch")
assert(stack_definitions.first.fetch("steps").length == 6, "sourced Stack Delivery step count mismatch")
assert(stack_definitions.first.fetch("steps").all? { |step| step.fetch("prompt").include?("[[botster-tui-kit-playbook]]") }, "every sourced role must carry TUI-kit routing")

if restart_verification
  persisted_run = initial_context.fetch("runs").find { |run| run["id"] == "run_live_authority" }
  assert(persisted_run, "workflow run did not survive Hub restart")
  assert(persisted_run["current_step_id"] == "botster_stack_review", "advanced workflow identity did not survive Hub restart")
  initialization_events = initial_context.fetch("events").count { |event| event["kind"] == "pipeline_source_initialized" }
  assert(initialization_events == 1, "Hub restart duplicated source initialization events")
  assert(initial_context.fetch("gate_results").length >= 3, "gate evidence did not survive Hub restart")
  assert(initial_context.fetch("reviews").length >= 2, "reviews did not survive Hub restart")
  assert(initial_context.fetch("questions").any? { |question| question["status"] == "answered" }, "question answer did not survive Hub restart")
  assert(initial_context.fetch("checklists").any?, "checklist did not survive Hub restart")
  assert(initial_context.fetch("pr_links").any?, "PR link did not survive Hub restart")
  render_surface(socket)
  puts "script/hub_acceptance_smoke: restart persistence verified"
  exit 0
end

project_id = "project_live_authority"
workspace_id = "workspace_live_authority"
created_project = call_tool(socket, "project_pipelines.create_project", {
  id: project_id,
  name: "Live contract project",
  repository: {
    id: "repo_live_contract",
    name: "example/live-contract",
    remote: "https://example.invalid/live-contract.git"
  },
  spawn_target_id: "spawn_target_live_contract",
  workspace_id: workspace_id
})
assert(created_project["ok"] == true, "live project setup failed")

surface = render_surface(socket)
create_form = find_node(surface, "project-pipelines-create-ticket-form")
create_button = find_node(surface, "project-pipelines-toolbar-create-ticket")
record_button = find_node(surface, "project-pipelines-toolbar-record-run")
activate_button = find_node(surface, "project-pipelines-toolbar-activate-step")
filter_button = find_node(surface, "project-pipelines-toolbar-filter-running")
project_table = find_node(surface, "project-pipelines-project-table")
assert(create_form, "rendered surface missing create ticket form")
assert(create_button && record_button && activate_button, "rendered surface missing dialog toolbar buttons")
assert(filter_button, "rendered surface missing filter button")
assert(project_table, "rendered surface missing project table")

create_action_id = create_form.dig("props", "action", "id")
filter_action_id = filter_button.dig("props", "action", "id")
assert(create_action_id == "project_pipelines.create_ticket", "rendered create action mismatch")
assert(filter_action_id == "project_pipelines.filter", "rendered filter action mismatch")

{
  create_button => "project-pipelines.create-ticket-dialog",
  record_button => "project-pipelines.record-run-dialog",
  activate_button => "project-pipelines.activate-step-dialog"
}.each_with_index do |(button, presentation_key), index|
  action = button.dig("props", "action")
  opened = dispatch_action(
    socket,
    action_id: action.fetch("id"),
    request_id: "live-open-dialog-#{index}",
    node_id: button.fetch("id"),
    payload: action.fetch("payload")
  )
  assert(opened["state"] == "accepted", "#{presentation_key} open action was not accepted")
  assert(opened.dig("presentation", 0, "kind") == "set", "#{presentation_key} was not opened")
  assert(opened.dig("presentation", 0, "key") == presentation_key, "#{presentation_key} open key mismatch")
end

filter = dispatch_action(
  socket,
  action_id: filter_action_id,
  request_id: "live-filter",
  node_id: filter_button.fetch("id"),
  payload: { status: "active" }
)
assert(filter["state"] == "accepted", "filter action was not accepted")
assert(filter.dig("payload", "filter") == "active", "filter payload did not arrive")
assert(filter.dig("presentation", 0, "kind") == "set", "filter did not set presentation")
assert(filter.dig("presentation", 0, "key") == "project-pipelines.filter", "filter presentation key mismatch")

workspace_row = project_table.fetch("props").fetch("rows").find { |row| row["id"] == project_id }
assert(workspace_row, "rendered project table missing live workspace row")
row_action = workspace_row.fetch("action")
assert(row_action.fetch("id") == "project_pipelines.select_row", "workspace row select action mismatch")
assert(row_action.dig("payload", "row_id") == workspace_id, "workspace row did not author its identity payload")
select = dispatch_action(
  socket,
  action_id: row_action.fetch("id"),
  request_id: "live-select",
  payload: row_action.fetch("payload")
)
assert(select["state"] == "accepted", "select action was not accepted")
assert(select.dig("payload", "row_id") == workspace_id, "select payload did not arrive")
assert(select.dig("presentation", 0, "key") == "selected-workspace", "select presentation key mismatch")
assert(select.dig("presentation", 0, "value") == workspace_id, "select presentation value mismatch")

ticket_id = "ticket_live_authority"
submitted_values = {
  id: ticket_id,
  project_id: project_id,
  title: "Live contract ticket"
}
created = dispatch_action(
  socket,
  action_id: create_action_id,
  request_id: "live-create",
  node_id: create_form.fetch("id"),
  values: submitted_values
)
assert(created["state"] == "accepted", "create action was not accepted")
assert(created.dig("payload", "ticket", "id") == ticket_id, "create values did not reach the domain mutation")
assert(created.dig("presentation", 0, "kind") == "clear", "create did not close its dialog")
assert(created.dig("presentation", 0, "key") == "project-pipelines.create-ticket-dialog", "create dialog key mismatch")
assert(created.dig("replacement", "id") == "project-pipelines-created-ticket", "create replacement mismatch")

rejected_values = {
  id: "ticket_live_rejected_#{Process.pid}",
  project_id: project_id,
  title: "   "
}
rejected = dispatch_action(
  socket,
  action_id: create_action_id,
  request_id: "live-create-rejected",
  node_id: create_form.fetch("id"),
  values: rejected_values
)
assert(rejected["state"] == "rejected", "invalid create was not rejected")
assert(rejected["normalized_values"] == rejected_values.transform_keys(&:to_s), "rejected create did not retain submitted values")
assert(rejected.dig("field_errors", "project-pipelines-create-ticket-title", 0) == "title is required", "rejected create field error mismatch")
assert(!rejected.key?("presentation"), "rejected create must preserve presentation")
assert(!rejected.key?("replacement"), "rejected create must not replace the tree")

presentation_bindings = []
each_node(surface) do |node|
  presentation_bindings << node if node["$kind"] == "presentation_if"
end
selected = presentation_bindings.find do |binding|
  binding.dig("predicate", "kind") == "equals" &&
    binding.dig("predicate", "key") == "selected-workspace"
end
assert(selected && selected.dig("predicate", "value") == workspace_id, "selected-workspace equality predicate missing")
assert(selected.dig("node", "props", "text") == "Workspace Live contract project selected", "selected workspace copy must derive from product data")

run_id = "run_live_authority"
run = call_tool(socket, "project_pipelines.record_run", {
  id: run_id,
  ticket_id: ticket_id,
  pipeline_definition_id: "botster_stack_delivery",
  spawn_target_id: "tgt_3dfae49c02454037bf13554f552baf7f",
  branch: "project-pipelines/live-authority",
  base_ref: "main",
  worktree: { kind: "provider_owned_reference", id: "worktree_live_authority" }
})
assert(run["ok"] == true && run.dig("run", "current_step_id") == "botster_stack_plan", "sourced run did not start at Plan")

plan_activation = call_tool(socket, "project_pipelines.activate_step", {
  run_id: run_id,
  step_id: "botster_stack_plan",
  request_id: "session_request_live_downstream_plan",
  session_template_id: "downstream-plan.fixture/plan"
})
assert(plan_activation["ok"] == true, "downstream TUI-kit Plan managed spawn failed: #{plan_activation.inspect}")
assert(plan_activation.dig("activation", "status") == "spawn_requested", "downstream Plan did not persist a spawn request")
assert(plan_activation.dig("activation", "request", "target_id") == "tgt_3dfae49c02454037bf13554f552baf7f", "downstream Plan used the wrong target")
assert(plan_activation.dig("activation", "result", "worktree_path"), "downstream Plan did not create a managed worktree")
assert(plan_activation.dig("activation", "result", "session_id"), "downstream Plan did not create a managed session")
assert(plan_activation.dig("activation", "request", "context", "prompt").include?("[[botster-tui-kit-playbook]]"), "production Plan prompt did not carry the TUI-kit charter")

blocked_plan = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-plan-before-gate"
})
assert(blocked_plan["ok"] == false && blocked_plan.dig("error", "code") == "transition_blocked", "missing Plan evidence must block")
call_tool(socket, "project_pipelines.record_artifact", {
  id: "artifact_live_plan",
  run_id: run_id,
  step_id: "botster_stack_plan",
  kind: "plan",
  summary: "Live public-path plan"
})
call_tool(socket, "project_pipelines.submit_gate", {
  run_id: run_id,
  step_id: "botster_stack_plan",
  gate_id: "plan_artifact",
  status: "passed",
  evidence: { artifact_id: "artifact_live_plan" }
})
plan_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-plan-advance"
})
assert(plan_advance["ok"] == true && plan_advance["step_id"] == "botster_stack_plan_review", "Plan did not advance through public MCP")
duplicate_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-plan-advance"
})
assert(duplicate_advance == plan_advance, "duplicate advance request did not reuse durable result")

call_tool(socket, "project_pipelines.submit_gate", {
  run_id: run_id,
  step_id: "botster_stack_plan_review",
  gate_id: "plan_review",
  status: "passed"
})
call_tool(socket, "project_pipelines.submit_review", {
  run_id: run_id,
  step_id: "botster_stack_plan_review",
  verdict: "changes_required",
  findings: [{ id: "finding_live_review", severity: "high", title: "Live review finding" }]
})
review_block = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-review-block"
})
assert(review_block["ok"] == false, "changes-required review must block public advance")
call_tool(socket, "project_pipelines.resolve_finding", {
  finding_id: "finding_live_review",
  resolution: "corrected in live flow"
})
call_tool(socket, "project_pipelines.submit_review", {
  run_id: run_id,
  step_id: "botster_stack_plan_review",
  verdict: "approved"
})
review_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-review-advance"
})
assert(review_advance["ok"] == true && review_advance["step_id"] == "botster_stack_implement", "approved review did not advance")

call_tool(socket, "project_pipelines.record_artifact", {
  id: "artifact_live_report",
  run_id: run_id,
  step_id: "botster_stack_implement",
  kind: "report",
  summary: "Live implementation report",
  payload: { files_changed: ["plugin.lua"], deviations_from_plan: [] }
})
checklist = call_tool(socket, "project_pipelines.create_checklist", {
  id: "checklist_live_vault",
  run_id: run_id,
  step_id: "botster_stack_implement",
  source: "vault",
  name: "Live vault discipline"
})
call_tool(socket, "project_pipelines.add_checklist_item", {
  checklist_id: checklist.dig("checklist", "id"),
  text: "Repository charter and targeted notes constrained the work",
  status: "completed"
})
question = call_tool(socket, "project_pipelines.record_question", {
  id: "question_live_authority",
  run_id: run_id,
  ticket_id: ticket_id,
  step_id: "botster_stack_implement",
  blocking: true,
  question: "Is the live workflow durable?"
})
call_tool(socket, "project_pipelines.answer_question", {
  question_id: question.dig("question", "id"),
  answer: "Yes; restart verification checks it."
})
call_tool(socket, "project_pipelines.submit_gate", {
  run_id: run_id,
  step_id: "botster_stack_implement",
  gate_id: "implementation",
  status: "passed",
  evidence: { commit_sha: "live-test-commit", diff_against_base: "plugin.lua changed" }
})
pr_block = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-implement-without-pr"
})
assert(pr_block["ok"] == false, "Implement must not advance without linked PR")
call_tool(socket, "project_pipelines.link_pr", {
  run_id: run_id,
  url: "https://example.invalid/project-pipelines/pull/1",
  provider: "test"
})
implement_advance = call_tool(socket, "project_pipelines.request_step_advance", {
  run_id: run_id,
  request_id: "live-implement-advance"
})
assert(implement_advance["ok"] == true && implement_advance["step_id"] == "botster_stack_review", "committed PR-backed implementation did not advance")

final_context = call_tool(socket, "project_pipelines.current_context", {})
assert(final_context.fetch("runs").any? { |record| record["id"] == run_id }, "current context missing live run")
assert(final_context.fetch("gate_results").count { |record| record["run_id"] == run_id } == 3, "run gate results missing")
assert(final_context.fetch("reviews").count { |record| record["run_id"] == run_id } == 2, "run reviews missing")
assert(final_context.fetch("findings").any? { |record| record["run_id"] == run_id && record["status"] == "resolved" }, "resolved finding missing")
assert(final_context.fetch("questions").any? { |record| record["run_id"] == run_id && record["status"] == "answered" }, "answered question missing")
assert(final_context.fetch("pr_links").count { |record| record["run_id"] == run_id } == 1, "PR link missing")
assert(final_context.fetch("questions").none? { |record| record["question"].to_s.downcase.include?("routing") }, "downstream Plan asked a repository routing question")
assert(final_context.fetch("events").none? { |record| record["kind"] == "question_asked" && record.dig("payload", "kind") == "repository_routing" }, "downstream Plan emitted a repository routing question event")

puts "script/hub_acceptance_smoke: ok project_id=#{project_id} ticket_id=#{ticket_id} client_authored_kind=submit"
