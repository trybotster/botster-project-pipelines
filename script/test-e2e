#!/bin/sh
# Runs the project-pipelines live smoke against a real daemon process. The Hub's
# own gate builds the candidate binaries (script/build-dev-artifacts);
# BOTSTER_PLUGIN_TEST names the runner binary.
set -eu
cd "$(dirname "$0")/.."
: "${BOTSTER_HUB_BIN:?set BOTSTER_HUB_BIN to the candidate Hub binary}"
: "${BOTSTER_SESSION_WORKER_BIN:?set BOTSTER_SESSION_WORKER_BIN to the candidate session worker}"
runner="${BOTSTER_PLUGIN_TEST:-botster-plugin-test}"
exec "$runner" --e2e --plugin . test/e2e/*_spec.lua
