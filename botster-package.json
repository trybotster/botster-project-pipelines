{
  "name": "project-pipelines",
  "version": "0.4.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [
    { "surface": "surfaces" },
    { "surface": "mcp" },
    { "surface": "plugin_db", "scope": "project-pipelines" },
    { "surface": "session_actions", "scope": "session_type_managed_git_spawn" }
  ],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "configuration": {
    "groups": [
      {
        "id": "defaults",
        "label": "Defaults"
      },
      {
        "id": "integrations",
        "label": "Integrations"
      }
    ],
    "fields": [
      {
        "key": "default_spawn_target_id",
        "type": "string",
        "label": "Default spawn target",
        "description": "Fallback hub spawn target used when a project does not provide one.",
        "group": "defaults"
      },
      {
        "key": "default_session_type_id",
        "type": "string",
        "label": "Default session type",
        "description": "Exact Hub session type id used for PTY-backed pipeline steps without a step-level id. Reload the package after changing this value.",
        "group": "defaults"
      },
      {
        "key": "default_pipeline_mode",
        "type": "select",
        "label": "Default pipeline mode",
        "description": "Default workflow shape for new tickets.",
        "group": "defaults",
        "default": { "type": "select", "value": "botster_delivery" },
        "options": [
          { "value": "botster_delivery", "label": "Botster delivery" },
          { "value": "manual_review", "label": "Manual review" }
        ]
      },
      {
        "key": "workspace_id",
        "type": "string",
        "label": "Workspace id",
        "description": "Optional workspace reference. Standalone project records remain valid without it.",
        "group": "integrations"
      }
    ]
  },
  "navigation": [
    {
      "id": "pipelines",
      "label": "Pipelines",
      "icon": "queue-list",
      "description": "Open the Project Pipelines operator workbench.",
      "target": { "kind": "surface", "surface_id": "project-pipelines.home" }
    }
  ],
  "surfaces": [
    {
      "id": "project-pipelines.home",
      "kind": "app",
      "title": "Project Pipelines",
      "description": "Project pipeline workbench for persisted projects and tickets.",
      "icon": "queue-list",
      "order": 30,
      "category": "workflows",
      "supports": ["render", "action"]
    },
    {
      "id": "project-pipelines.settings",
      "kind": "settings",
      "title": "Project Pipelines Settings",
      "description": "Project Pipelines package settings and persistence status.",
      "icon": "adjustments-horizontal",
      "order": 30,
      "category": "workflows",
      "supports": ["render"]
    }
  ],
  "features": [
    {
      "id": "standalone_authority",
      "label": "Standalone Project Pipelines authority"
    },
    {
      "id": "botster_stack_delivery",
      "label": "Sourced Botster Stack Delivery workflow"
    },
    {
      "id": "durable_workflow_engine",
      "label": "Durable workflow gates, reviews, findings, questions, and artifacts"
    },
    {
      "id": "atomic_lifecycle_projection",
      "label": "Atomic ticket, run, and run-step lifecycle projection"
    }
  ],
  "events": {
    "emitted": [
      {
        "name": "pr_merged",
        "audience": ["plugins"],
        "payload_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": { "type": "string", "maxLength": 128 },
            "pr_url": { "type": "string", "maxLength": 512 },
            "merge_commit": { "type": "string", "maxLength": 128 }
          }
        }
      },
      {
        "name": "question.opened",
        "audience": ["clients", "plugins"],
        "payload_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "kind": { "type": "string", "enum": ["human", "agent"] },
            "notice": { "type": "string", "minLength": 1, "maxLength": 280 },
            "blocking": { "type": "boolean" },
            "run_id": { "type": "string", "maxLength": 128 },
            "step_id": { "type": "string", "maxLength": 128 },
            "ticket_id": { "type": "string", "maxLength": 128 },
            "subject": { "type": "string", "maxLength": 128 }
          },
          "required": ["question_id", "kind", "notice"]
        }
      }
    ],
    "notices": [
      {
        "name": "question.opened",
        "subject_scope": "session",
        "text_pointer": "/notice",
        "ttl_ms": 10000,
        "severity": "warning"
      }
    ]
  }
}
